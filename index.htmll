function toggleChat(){
  var cd=document.getElementById("chat-dot");if(cd)cd.style.display="none";
  var tc2=document.getElementById("tool-chat");if(tc2)tc2.classList.remove("has-new");
  var c=document.getElementById("chat");
  if(c.style.display==="flex"||c.classList.contains("show")){
    c.classList.remove("show");c.style.display="none";
  }else{
    c.classList.add("show");c.style.display="flex";c.style.zIndex="200";loadChat();
    var ch=document.getElementById("chat-help");
    if(ch)ch.style.display=(user&&user.is_mod)?"inline-grid":"none";
  }
}
