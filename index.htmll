<div class="overlay" id="ov-videos"><div class="modal" style="max-width:440px">
<h2>Videos</h2>
<div id="videos-list" style="max-height:40vh;overflow-y:auto;font-size:13px"></div>
<hr style="border-color:var(--border);margin:10px 0">
<label>Name</label><input id="vid-title">
<label>About</label><input id="vid-about">
<label>Link</label><input id="vid-url">
<div class="row"><button id="vid-post">Publish</button><button class="ghost" onclick="closeOv('ov-videos')">Close</button></div>
</div></div>
<div class="overlay" id="ov-questions"><div class="modal">
<h2>Questions</h2>
<div id="q-list" style="max-height:40vh;overflow-y:auto;font-size:13px"></div>
<label>Your question</label><input id="q-text" maxlength="500">
<div class="row"><button id="q-post">Ask</button><button class="ghost" onclick="closeOv('ov-questions')">Close</button></div>
</div></div>
<div class="overlay" id="ov-report"><div class="modal">
<h2>Report</h2>
<label>@username</label><input id="rep-target" placeholder="user">
<label>Reason</label>
<select id="rep-reason">
<option value="1.1 Doting">1.1 Doting 50m</option>
<option value="1.2 Wave Attack">1.2 Wave Attack 200m</option>
<option value="1.3 Obscene">1.3 Obscene symbols 200m</option>
<option value="2.1 Politics">2.1 Politic discussion 100m</option>
<option value="2.2 Spam">2.2 Spam 2m/30m</option>
<option value="2.3 ADS">2.3 ADS 40m</option>
<option value="other">Other</option>
</select>
<label>Comment (max 400)</label><textarea id="rep-comment" maxlength="400" rows="3" style="width:100%;background:#0b0e14;color:var(--text);border:1px solid var(--border);border-radius:8px;padding:8px"></textarea>
<div class="row"><button id="rep-send">Send</button><button class="ghost" onclick="closeOv('ov-report')">Close</button></div>
</div></div>

</body>
</html>
