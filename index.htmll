// build mode checkboxes
function loadBuildCfgUI(){
  var map={pencil:"bm-pencil",b3:"bm-3",b5:"bm-5",p3:"bm-p3",p5:"bm-p5"};
  Object.keys(map).forEach(function(k){
    var el=document.getElementById(map[k]);
    if(!el)return;
    el.checked=!!buildCfg[k];
    el.onchange=function(){
      buildCfg[k]=el.checked;
      localStorage.setItem("bm_"+k, el.checked?"1":"0");
      // also map keys for pencil etc
      if(k==="pencil")localStorage.setItem("bm_pencil",el.checked?"1":"0");
      updateDraftUI();
    };
  });
}
// fix storage keys align with buildCfg
["pencil","b3","b5","p3","p5"].forEach(function(k){
  var id={pencil:"bm_pencil",b3:"bm_3",b5:"bm_5",p3:"bm_p3",p5:"bm_p5"}[k];
  buildCfg[k]=localStorage.getItem(id)==="1";
});

var keysHeld={};
var camLoop=null;
function startCamLoop(){
  if(camLoop)return;
  camLoop=setInterval(function(){
    if(deviceMode!=="pc")return;
    var spd=Math.max(4, 12/Math.max(0.2,scale));
    var moved=false;
    if(keysHeld["w"]||keysHeld["W"]){oy+=spd;moved=true;}
    if(keysHeld["s"]||keysHeld["S"]){oy-=spd;moved=true;}
    if(keysHeld["a"]||keysHeld["A"]){ox+=spd;moved=true;}
    if(keysHeld["d"]||keysHeld["D"]){ox-=spd;moved=true;}
    if(moved)apply();
  },16);
}
startCamLoop();

window.addEventListener("keydown",function(e){
  if(deviceMode!=="pc")return;
  var tag=(e.target&&e.target.tagName)||"";
  if(tag==="INPUT"||tag==="TEXTAREA"||tag==="SELECT")return;
  keysHeld[e.key]=true;
  var k=e.key.toLowerCase();
  if(k==="z"){var r=wrap.getBoundingClientRect();zoomAt(r.width/2,r.height/2,1.15);e.preventDefault();}
  if(k==="x"){var r=wrap.getBoundingClientRect();zoomAt(r.width/2,r.height/2,1/1.15);e.preventDefault();}
  if(k==="q"){autoMode=!autoMode;notify(autoMode?"Template mode":"Pixel mode");e.preventDefault();}
  if(k==="e"){landMode=(landMode+1)%3;syncTerrainBtn();notify(landMode===1?"Land only":landMode===2?"Water only":"Filter OFF");e.preventDefault();}
  if(k==="r"){document.getElementById("tool-radar").click();e.preventDefault();}
  if(k==="p"){/* lookup removed */e.preventDefault();}
  if(k==="c"){document.getElementById("tool-chat")&&document.getElementById("tool-chat").click();e.preventDefault();}
  if(k==="1"||k==="2"){
    var chs=["en","ru"];
    channel=chs[+k-1];
    var chat=document.getElementById("chat");
    if(chat){chat.classList.add("show");chat.style.display="flex";}
    document.querySelectorAll("#chat-tabs button").forEach(function(b){b.classList.toggle("active",b.dataset.ch===channel);});
    loadChat();
    e.preventDefault();
  }
  if(k==="k"){
    document.querySelectorAll(".overlay.show").forEach(function(o){o.classList.remove("show");});
    var chat=document.getElementById("chat");if(chat){chat.classList.remove("show");chat.style.display="none";}
    e.preventDefault();
  }
  if(k==="m"){document.getElementById("coin-btn")&&document.getElementById("coin-btn").click();e.preventDefault();}
  if(k==="t"){document.getElementById("tool-pencil").click();e.preventDefault();}
  if(k==="h"){
    document.body.classList.toggle("show-cursor");
    notify(document.body.classList.contains("show-cursor")?"Cursor ON":"Cursor OFF");
    e.preventDefault();
  }
});
window.addEventListener("keyup",function(e){keysHeld[e.key]=false;});

// CSS for cursor
