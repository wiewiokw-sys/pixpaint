})();


var __el_btn_news=document.getElementById("btn-news");if(__el_btn_news)__el_btn_news.onclick=async function(){
  document.getElementById("menu").classList.remove("show");
  var mod=document.getElementById("news-mod");
  if(mod)mod.style.display=(user&&user.is_mod)?"block":"none";
  await renderNews();
  openOv("ov-news");
  localStorage.setItem("news_seen", Date.now());
  var nd=document.getElementById("news-dot");if(nd)nd.style.display="none";
};
async function renderNews(){
  var list=document.getElementById("news-list");
  if(!list)return;
  list.innerHTML="Loading...";
  try{
    var items=await api("/news");
    if(!items.length){list.innerHTML="<p style='color:var(--muted)'>No news yet</p>";return;}
    list.innerHTML=items.map(function(n){
      var img=n.image_url?("<img src='"+n.image_url+"' style='max-width:100%;border-radius:8px;margin:6px 0'>"):"";
      var comments=(n.comments||[]).map(function(c){return "<div style='font-size:11px;margin:2px 0'><b>@"+c.username+"</b> "+c.text+"</div>";}).join("");
      return "<div style='border:1px solid var(--border);border-radius:10px;padding:10px;margin-bottom:8px'>"+
        "<b>"+n.title+"</b><div style='font-size:11px;color:var(--muted)'>@"+n.author+" · "+(n.created||"").slice(0,16)+"</div>"+
        "<div style='margin:6px 0;font-size:13px'>"+n.body+"</div>"+img+
        "<div style='display:flex;gap:8px;margin-top:6px;flex-wrap:wrap'>"+
        "<button onclick=\"newsReact('"+n.id+"','like')\">+ "+(n.likes||0)+"</button>"+
        "<button onclick=\"newsReact('"+n.id+"','dislike')\">- "+(n.dislikes||0)+"</button>"+
        (user&&user.is_mod?("<button class='danger' onclick=\"newsDel('"+n.id+"')\">Del</button>"):"")+
        "</div>"+
        "<div style='margin-top:6px'>"+comments+"</div>"+
        "<div style='display:flex;gap:4px;margin-top:4px'><input id='nc-"+n.id+"' placeholder='Comment...' style='flex:1'><button onclick=\"newsComment('"+n.id+"')\">Send</button></div></div>";
    }).join("");
  }catch(e){list.innerHTML="Error";}
}
window.newsReact=async function(id,r){try{await api("/news/react",{method:"POST",json:{nid:id,reaction:r}});renderNews();}catch(e){notify(e.message);}};
window.newsComment=async function(id){var el=document.getElementById("nc-"+id);if(!el||!el.value.trim())return;try{await api("/news/comment",{method:"POST",json:{nid:id,text:el.value.trim()}});renderNews();}catch(e){notify(e.message);}};
window.newsDel=async function(id){try{await api("/news/delete",{method:"POST",json:{nid:id}});notify("Deleted");renderNews();}catch(e){notify(e.message);}};
var __el_news_post=document.getElementById("news-post");if(__el_news_post)__el_news_post.onclick=async function(){
  try{
    await api("/news",{method:"POST",json:{title:document.getElementById("news-title").value,body:document.getElementById("news-body").value,image_url:document.getElementById("news-img").value}});
    notify("Published");renderNews();
  }catch(e){notify(e.message);}
};
async function checkNewsDot(){
  try{
    var items=await api("/news");
    if(!items.length)return;
    var seen=+localStorage.getItem("news_seen")||0;
    var newest=items[0].created?new Date(items[0].created).getTime():0;
    var nd=document.getElementById("news-dot");
    if(nd)nd.style.display=newest>seen?"inline-block":"none";
  }catch(e){}
}
window.gotoPixel=function(x,y){
  closeOv("ov-mod-recent");
  var r=wrap.getBoundingClientRect();
  scale=Math.max(scale,10);
  ox=r.width/2-x*scale-scale/2;
  oy=r.height/2-y*scale-scale/2;
  apply();
  remoteGlow(x,y);
  notify("→ "+x+", "+y);
};

