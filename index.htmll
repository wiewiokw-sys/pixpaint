    "<p style='margin-top:8px;font-size:13px'>Stock: "+user.pixels_left+" / "+user.limit+(user.god_mode?" GOD":"")+"<br>Placed by this account: <b>"+(user.pixels_placed||0)+"</b></p>";
  var m=user.medals||{};
