<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>PixPaint</title>
<style>
:root{--bg:#0b0e14;--panel:#151a23;--panel2:#1c2330;--border:#2a3344;--text:#e8eef7;--muted:#8b9bb4;--accent:#3b82f6;--green:#22c55e;--danger:#ef4444}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;overflow:hidden;background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,sans-serif;user-select:none}
#app{display:flex;height:100vh;width:100vw}
#sidebar{width:52px;background:var(--panel);border-right:1px solid var(--border);display:flex;flex-direction:column;align-items:center;padding:10px 0;gap:6px;z-index:30}
.side-btn{width:40px;height:40px;border-radius:10px;border:none;background:transparent;color:var(--muted);cursor:pointer;display:grid;place-items:center;transition:.15s}
.side-btn:hover,.side-btn.active{background:var(--panel2);color:var(--text)}
.side-btn svg{width:20px;height:20px;fill:currentColor}
#main{flex:1;position:relative;overflow:hidden;background:#0a1020}
#canvas-wrap{position:absolute;inset:0;overflow:hidden;cursor:grab;touch-action:none}
#canvas-wrap.painting{cursor:crosshair}
#canvas-wrap.looking{cursor:help}
#canvas-wrap.dragging{cursor:grabbing}
#bg-map,#pixel-canvas,#template-canvas{position:absolute;top:0;left:0;image-rendering:pixelated;image-rendering:crisp-edges;transform-origin:0 0;pointer-events:none}
#hud{position:absolute;top:10px;left:50%;transform:translateX(-50%);background:rgba(21,26,35,.92);border:1px solid var(--border);border-radius:999px;padding:6px 16px;display:flex;align-items:center;gap:14px;z-index:20;backdrop-filter:blur(10px);font-size:13px;white-space:nowrap}
#coords{font-family:ui-monospace,monospace;color:var(--muted)}
#pix-info{color:var(--green);font-weight:600}
#user-chip{color:var(--accent);font-weight:600;display:none}
#tools{position:absolute;right:10px;top:10px;display:flex;flex-direction:column;gap:6px;z-index:20}
.tool{width:42px;height:42px;border-radius:10px;border:1px solid var(--border);background:var(--panel);color:var(--muted);cursor:pointer;display:grid;place-items:center;transition:.15s}
.tool:hover,.tool.active{border-color:var(--accent);color:var(--text);background:var(--panel2)}
.tool svg{width:18px;height:18px;fill:currentColor}
.tool span{font-size:12px;font-weight:700}
#palette-bar{position:absolute;bottom:58px;left:50%;transform:translateX(-50%);z-index:20;display:flex;flex-direction:column;align-items:center;gap:6px;max-width:min(96vw,520px)}
#palette-nav{display:flex;gap:8px;align-items:center}
#palette-nav button{width:32px;height:28px;border-radius:8px;border:1px solid var(--border);background:var(--panel);color:var(--text);cursor:pointer;font-size:14px}
#palette-page{font-size:12px;color:var(--muted);min-width:48px;text-align:center}
#palette{display:grid;grid-template-columns:repeat(10,1fr);gap:4px;background:rgba(21,26,35,.95);border:1px solid var(--border);border-radius:14px;padding:8px;backdrop-filter:blur(8px)}
.swatch{width:26px;height:26px;border-radius:6px;cursor:pointer;border:2px solid transparent;transition:transform .1s}
.swatch:hover{transform:scale(1.12)}
.swatch.selected{border-color:#fff;box-shadow:0 0 0 1px #000}
#bottom{position:absolute;bottom:0;left:0;right:0;height:52px;background:var(--panel);border-top:1px solid var(--border);display:flex;align-items:center;padding:0 10px;gap:8px;z-index:20;overflow-x:auto}
.bot{height:34px;padding:0 12px;border-radius:8px;border:1px solid var(--border);background:var(--panel2);color:var(--text);cursor:pointer;font-size:13px;display:flex;align-items:center;gap:6px;white-space:nowrap}
.bot:hover{border-color:var(--accent)}
.bot.primary{background:var(--accent);border-color:var(--accent);font-weight:600}
#status{margin-left:auto;font-size:12px;color:var(--muted)}
#lookup{position:absolute;z-index:40;display:none;min-width:210px;background:var(--panel);border:1px solid var(--border);border-radius:12px;padding:12px 14px;box-shadow:0 12px 40px rgba(0,0,0,.45)}
#lookup .name{font-weight:700;font-size:15px}
#lookup .meta{color:var(--muted);font-size:12px;margin-top:3px}
#lookup .medals{margin:6px 0;font-size:13px}
#lookup .acts{display:flex;flex-wrap:wrap;gap:5px;margin-top:8px}
#lookup .acts button{font-size:11px;padding:5px 8px;border-radius:6px;border:none;background:var(--panel2);color:var(--text);cursor:pointer}
#lookup .acts button.danger{background:var(--danger)}
#chat{position:absolute;right:10px;bottom:62px;width:300px;max-height:320px;background:rgba(21,26,35,.97);border:1px solid var(--border);border-radius:12px;display:none;flex-direction:column;z-index:25}
#chat.show{display:flex}
#chat-tabs{display:flex;border-bottom:1px solid var(--border)}
#chat-tabs button{flex:1;padding:8px 4px;border:none;background:transparent;color:var(--muted);cursor:pointer;font-size:11px}
#chat-tabs button.active{color:var(--text);border-bottom:2px solid var(--accent)}
#chat-msgs{flex:1;overflow-y:auto;padding:8px;font-size:13px;max-height:220px}
.msg{margin-bottom:5px;line-height:1.35}
.msg .u{font-weight:600;color:#60a5fa}
.msg .u.mod{color:#f97316}
#chat-row{display:flex;border-top:1px solid var(--border)}
#chat-input{flex:1;border:none;background:transparent;padding:10px;color:var(--text);font-size:13px}
#chat-send{border:none;background:var(--accent);color:#fff;padding:0 14px;cursor:pointer}
.overlay{position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:100;display:none;align-items:center;justify-content:center;padding:12px}
.overlay.show{display:flex}
.modal{background:var(--panel);border:1px solid var(--border);border-radius:16px;padding:20px;width:min(420px,96vw);max-height:88vh;overflow-y:auto}
.modal h2{font-size:17px;margin-bottom:12px}
.modal h3{font-size:14px;margin:14px 0 8px;color:var(--muted)}
.modal input,.modal select{width:100%;padding:10px 12px;margin:4px 0 10px;border-radius:8px;border:1px solid var(--border);background:#0b0e14;color:var(--text);font-size:14px}
.modal .row{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
.modal button{padding:9px 14px;border-radius:8px;border:none;background:var(--accent);color:#fff;font-weight:600;cursor:pointer;font-size:13px}
.modal button.ghost{background:var(--panel2);border:1px solid var(--border);color:var(--text)}
.modal button.danger{background:var(--danger)}
#earn-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:10px 0}
.earn-opt{padding:14px 6px;border-radius:10px;border:1px solid var(--border);background:var(--panel2);text-align:center;cursor:pointer;font-size:13px;text-transform:capitalize}
.earn-opt:hover{border-color:var(--accent)}
.clan-item{display:flex;justify-content:space-between;align-items:center;padding:10px;border:1px solid var(--border);border-radius:8px;margin-bottom:8px}
.setting{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid var(--border);font-size:14px}
.toggle{width:42px;height:24px;border-radius:12px;background:#334155;position:relative;cursor:pointer}
.toggle.on{background:var(--green)}
.toggle::after{content:"";position:absolute;width:18px;height:18px;border-radius:50%;background:#fff;top:3px;left:3px;transition:.15s}
.toggle.on::after{left:21px}
#notify{position:fixed;top:16px;right:16px;background:var(--panel);border:1px solid var(--border);padding:12px 16px;border-radius:10px;z-index:200;display:none;max-width:280px;font-size:13px}
#notify.show{display:block}
</style>
</head>
<body>
<div id="app">
<aside id="sidebar">
<button class="side-btn" id="btn-profile" title="Profile"><svg viewBox="0 0 24 24"><path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/></svg></button>
<button class="side-btn" id="btn-settings" title="Settings"><svg viewBox="0 0 24 24"><path d="M19.1 12.9c.1-.3.1-.6.1-.9s0-.6-.1-.9l2.1-1.6c.2-.1.2-.4.1-.6l-2-3.5c-.1-.2-.4-.3-.6-.2l-2.5 1c-.5-.4-1.1-.7-1.7-.9l-.4-2.6c0-.2-.2-.4-.5-.4h-4c-.2 0-.5.2-.5.4l-.4 2.6c-.6.2-1.2.5-1.7.9l-2.5-1c-.2-.1-.5 0-.6.2l-2 3.5c-.1.2 0 .5.2.6l2.1 1.6c-.1.3-.1.6-.1.9s0 .6.1.9L2.8 14.5c-.2.1-.2.4-.1.6l2 3.5c.1.2.4.3.6.2l2.5-1c.5.4 1.1.7 1.7.9l.4 2.6c0 .2.2.4.5.4h4c.2 0 .5-.2.5-.4l.4-2.6c.6-.2 1.2-.5 1.7-.9l2.5 1c.2.1.5 0 .6-.2l2-3.5c.1-.2 0-.5-.1-.6l-2.2-1.6zM12 15.5c-1.9 0-3.5-1.6-3.5-3.5s1.6-3.5 3.5-3.5 3.5 1.6 3.5 3.5-1.6 3.5-3.5 3.5z"/></svg></button>
<button class="side-btn" id="btn-download" title="Screenshot"><svg viewBox="0 0 24 24"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg></button>
<button class="side-btn" id="btn-template" title="Template"><svg viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zm-5-7l-3 3.72L9 13l-3 4h12l-4-5z"/></svg></button>
<button class="side-btn" id="btn-clans" title="Clans"><svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.5 3.8 10.7 9 12 5.2-1.3 9-6.5 9-12V5l-9-4zm0 2.2l7 3.1v4.7c0 4.4-2.9 8.6-7 9.8-4.1-1.2-7-5.4-7-9.8V6.3l7-3.1zM11 7v6h2V7h-2zm0 8v2h2v-2h-2z"/></svg></button>
<div style="flex:1"></div>
<button class="side-btn" id="btn-chat" title="Chat"><svg viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H5.2L4 17.2V4h16v12z"/></svg></button>
</aside>
<div id="main">
<div id="canvas-wrap">
<img id="bg-map" src="world_map.png" alt="" draggable="false" style="width:4096px;height:4096px;object-fit:fill">
<canvas id="template-canvas" width="4096" height="4096"></canvas>
<canvas id="pixel-canvas" width="4096" height="4096"></canvas>
</div>
<div id="hud"><span id="coords">0000 x 0000</span><span style="opacity:.3">|</span><span>Pixels: <span id="pix-info">60 / 60</span></span><span id="user-chip"></span></div>
<div id="tools">
<button class="tool active" id="tool-paint" title="Paint"><svg viewBox="0 0 24 24"><path d="M7 14c-1.7 0-3 1.3-3 3 0 1.3-1 2-2 2 .8 1.3 2.5 2 4 2 2.2 0 4-1.8 4-4 0-1.7-1.3-3-3-3zm13.7-9.3c.4-.4.4-1 0-1.4l-2-2c-.4-.4-1-.4-1.4 0L9 11.6 7.4 10 6 11.4l2.8 2.8L3 20h3l7.8-7.8 2.8 2.8 1.4-1.4-1.6-1.6L20.7 4.7z"/></svg></button>
<button class="tool" id="tool-lookup" title="Lookup"><svg viewBox="0 0 24 24"><path d="M15.5 14h-.8l-.3-.3C15.4 12.6 16 11.4 16 10c0-3.3-2.7-6-6-6S4 6.7 4 10s2.7 6 6 6c1.4 0 2.6-.6 3.7-1.5l.3.3v.8l5 5 1.5-1.5-5-5zm-5.5 0C8 14 6 12 6 10s2-4 4-4 4 2 4 4-2 4-4 4z"/></svg></button>
<button class="tool" id="brush-1"><span>1</span></button>
<button class="tool" id="brush-3"><span>3</span></button>
<button class="tool" id="brush-5"><span>5</span></button>
</div>
<div id="palette-bar">
<div id="palette-nav"><button id="pal-prev">&lsaquo;</button><span id="palette-page">1 / 5</span><button id="pal-next">&rsaquo;</button></div>
<div id="palette"></div>
</div>
<div id="bottom">
<button class="bot primary" id="btn-earn">Earn</button>
<button class="bot" id="btn-auth">Login</button>
<button class="bot" id="btn-clear-mod" style="display:none">Clear water</button>
<span id="status">Connecting...</span>
</div>
<div id="lookup"></div>
<div id="chat">
<div id="chat-tabs">
<button class="active" data-ch="global">Global</button>
<button data-ch="ru">RU</button>
<button data-ch="en">EN</button>
<button data-ch="ar">AR</button>
<button data-ch="tr">TR</button>
</div>
<div id="chat-msgs"></div>
<div id="chat-row"><input id="chat-input" placeholder="Message..." maxlength="200"><button id="chat-send">Send</button></div>
</div>
</div>
</div>
<div id="notify"></div>
<div class="overlay" id="ov-auth"><div class="modal"><h2 id="auth-title">Login</h2><input id="auth-user" placeholder="Username"><input id="auth-pass" type="password" placeholder="Password"><div class="row"><button id="auth-go">OK</button><button class="ghost" id="auth-switch">Register?</button><button class="ghost" onclick="closeOv('ov-auth')">Close</button></div></div></div>
<div class="overlay" id="ov-profile"><div class="modal"><h2>Profile</h2><div id="profile-body"></div><h3>Become moderator</h3><input id="mod-code" placeholder="Mod code"><div class="row"><button id="btn-mod">Submit</button><button class="ghost" onclick="closeOv('ov-profile')">Close</button></div></div></div>
<div class="overlay" id="ov-settings"><div class="modal"><h2>Settings</h2><div class="setting"><span>Canvas grid</span><div class="toggle on" id="tog-grid"></div></div><div class="setting"><span>Pixel notifications</span><div class="toggle on" id="tog-notif"></div></div><div class="setting"><span>History mode</span><div class="toggle" id="tog-hist"></div></div><div class="setting"><span>Sounds</span><div class="toggle on" id="tog-sound"></div></div><div class="setting"><span>Language</span><select id="lang" style="width:auto"><option value="en">English</option><option value="ru">Russian</option><option value="tr">Turkish</option></select></div><div class="row" style="margin-top:14px"><button class="ghost" onclick="closeOv('ov-settings')">Close</button></div></div></div>
<div class="overlay" id="ov-earn"><div class="modal"><h2>Earn pixels</h2><p style="color:var(--muted);font-size:13px">Choose the correct animal</p><div id="earn-grid"></div><p id="earn-msg" style="font-size:13px;min-height:18px"></p><button class="ghost" onclick="closeOv('ov-earn')">Close</button></div></div>
<div class="overlay" id="ov-clans"><div class="modal"><h2>Clans</h2><div id="clans-body"></div><h3>Create clan</h3><input id="clan-name" placeholder="Clan name"><div class="row"><button id="btn-clan-create">Create</button><button class="ghost" onclick="closeOv('ov-clans')">Close</button></div></div></div>
<div class="overlay" id="ov-template"><div class="modal"><h2>Template overlay</h2><p style="font-size:13px;color:var(--muted);margin-bottom:8px">Upload image - it appears semi-transparent. Draw on top of it.</p><input type="file" id="tpl-file" accept="image/*"><div class="setting" style="margin-top:10px"><span>Show template</span><div class="toggle on" id="tog-tpl"></div></div><div class="setting"><span>Opacity</span><input type="range" id="tpl-opacity" min="10" max="90" value="45" style="width:120px"></div><div class="row"><button class="danger" id="btn-tpl-clear">Remove</button><button class="ghost" onclick="closeOv('ov-template')">Close</button></div></div></div>
<div class="overlay" id="ov-clear"><div class="modal"><h2>Clear water / area</h2><p style="font-size:13px;color:var(--muted)">Two corners = rectangle. Or full clear.</p><div style="display:grid;grid-template-columns:1fr 1fr;gap:8px"><input id="cx1" type="number" value="0"><input id="cy1" type="number" value="0"><input id="cx2" type="number" value="200"><input id="cy2" type="number" value="200"></div><label style="display:flex;gap:8px;align-items:center;margin:12px 0;font-size:13px"><input type="checkbox" id="cfull"> Full canvas clear</label><div class="row"><button class="danger" id="btn-do-clear">Clear</button><button class="ghost" onclick="closeOv('ov-clear')">Cancel</button></div></div></div>
<script>

(function(){
const SIZE=4096;
const HUES=[{h:0},{h:15},{h:30},{h:45},{h:60},{h:90},{h:120},{h:150},{h:180},{h:200},{h:220},{h:240},{h:270},{h:300},{h:330}];
const SHADES=[{s:90,l:18},{s:85,l:32},{s:80,l:50},{s:90,l:65},{s:95,l:78}];
const ALL=[];
HUES.forEach(function(hue){SHADES.forEach(function(sh){ALL.push("hsl("+hue.h+" "+sh.s+"% "+sh.l+"%)");});});
[8,20,40,60,80,92].forEach(function(l){ALL.push("hsl(0 0% "+l+"%)");});
const PAGE_SIZE=30;const PAGES=[];
for(let i=0;i<ALL.length;i+=PAGE_SIZE)PAGES.push(ALL.slice(i,i+PAGE_SIZE));
let token=localStorage.getItem("pix_token");
let user=null,color=ALL[12],tool="paint",brush=1,scale=0.25,ox=0,oy=0;
let dragging=false,spaceDown=false,last={x:0,y:0},ws=null,earnCD=0,channel="global",placing=false,palPage=0;
const wrap=document.getElementById("canvas-wrap");
const canvas=document.getElementById("pixel-canvas");
const ctx=canvas.getContext("2d",{alpha:true});
const bgMap=document.getElementById("bg-map");
const tplCanvas=document.getElementById("template-canvas");
const tplCtx=tplCanvas.getContext("2d");
ctx.clearRect(0,0,SIZE,SIZE);
function apply(){const t="translate("+ox+"px,"+oy+"px) scale("+scale+")";canvas.style.transform=t;bgMap.style.transform=t;tplCanvas.style.transform=t;}
function centerView(){const w=wrap.clientWidth,h=wrap.clientHeight;scale=Math.min(w/SIZE,h/SIZE)*0.95;ox=(w-SIZE*scale)/2;oy=(h-SIZE*scale)/2;apply();}
function renderPalette(){const el=document.getElementById("palette");el.innerHTML="";(PAGES[palPage]||[]).forEach(function(c){const d=document.createElement("div");d.className="swatch"+(c===color?" selected":"");d.style.background=c;d.onclick=function(){color=c;renderPalette();};el.appendChild(d);});document.getElementById("palette-page").textContent=(palPage+1)+" / "+PAGES.length;}
document.getElementById("pal-prev").onclick=function(){palPage=(palPage-1+PAGES.length)%PAGES.length;renderPalette();};
document.getElementById("pal-next").onclick=function(){palPage=(palPage+1)%PAGES.length;renderPalette();};
renderPalette();
async function api(path,opts){opts=opts||{};const headers=Object.assign({},opts.headers||{});if(token)headers["Authorization"]="Bearer "+token;if(opts.json){headers["Content-Type"]="application/json";opts.body=JSON.stringify(opts.json);}const res=await fetch(path,Object.assign({},opts,{headers:headers}));let data={};try{data=await res.json();}catch(e){}if(!res.ok)throw new Error(data.detail||data.msg||res.statusText||"Error");return data;}
async function loadMe(){try{const d=await api("/me");if(d.guest){user=null;document.getElementById("pix-info").textContent=d.pixels_left+" / "+d.limit;document.getElementById("user-chip").style.display="none";document.getElementById("btn-clear-mod").style.display="none";}else{user=d;document.getElementById("pix-info").textContent=d.pixels_left+" / "+d.limit;const chip=document.getElementById("user-chip");chip.style.display="inline";chip.textContent="@"+d.username+(d.is_mod?" MOD":"");document.getElementById("btn-clear-mod").style.display=d.is_mod?"inline-flex":"none";}updateAuthBtn();}catch(e){document.getElementById("pix-info").textContent="60 / 60";}}
function updateAuthBtn(){const b=document.getElementById("btn-auth");if(user){b.textContent="Logout";b.onclick=function(){token=null;localStorage.removeItem("pix_token");user=null;updateAuthBtn();loadMe();};}else{b.textContent="Login";b.onclick=function(){openAuth(false);};}}
function connectWS(){const proto=location.protocol==="https:"?"wss":"ws";try{ws=new WebSocket(proto+"://"+location.host+"/ws");}catch(e){document.getElementById("status").textContent="No backend";return;}ws.onopen=function(){document.getElementById("status").textContent="Online";document.getElementById("status").style.color="var(--green)";};ws.onclose=function(){document.getElementById("status").textContent="Reconnecting...";document.getElementById("status").style.color="#eab308";setTimeout(connectWS,2500);};ws.onmessage=function(ev){try{const m=JSON.parse(ev.data);if(m.type==="pixel"){ctx.fillStyle=m.color;ctx.fillRect(m.x,m.y,1,1);}else if(m.type==="clear"){ctx.clearRect(m.x1,m.y1,m.x2-m.x1+1,m.y2-m.y1+1);}else if(m.type==="clear_all"){ctx.clearRect(0,0,SIZE,SIZE);}else if(m.type==="chat")appendChat(m);}catch(e){};};}
wrap.addEventListener("wheel",function(e){e.preventDefault();const rect=wrap.getBoundingClientRect();const mx=e.clientX-rect.left,my=e.clientY-rect.top;const factor=e.deltaY>0?0.9:1.12;const ns=Math.min(50,Math.max(0.04,scale*factor));ox=mx-(mx-ox)*(ns/scale);oy=my-(my-oy)*(ns/scale);scale=ns;apply();},{passive:false});
function startDrag(x,y){dragging=true;last={x:x,y:y};wrap.classList.add("dragging");}
function moveDrag(x,y){if(!dragging)return;ox+=x-last.x;oy+=y-last.y;last={x:x,y:y};apply();}
function endDrag(){dragging=false;wrap.classList.remove("dragging");}
wrap.addEventListener("mousedown",function(e){if(e.button===1||e.button===2||spaceDown||tool!=="paint"){e.preventDefault();startDrag(e.clientX,e.clientY);}});
window.addEventListener("mousemove",function(e){moveDrag(e.clientX,e.clientY);updateCoords(e.clientX,e.clientY);});
window.addEventListener("mouseup",endDrag);
window.addEventListener("keydown",function(e){if(e.code==="Space"){spaceDown=true;wrap.style.cursor="grab";e.preventDefault();}});
window.addEventListener("keyup",function(e){if(e.code==="Space"){spaceDown=false;setCursor();}});
let touchMode=null,lastDist=0;
wrap.addEventListener("touchstart",function(e){if(e.touches.length===2){touchMode="pinch";const dx=e.touches[0].clientX-e.touches[1].clientX,dy=e.touches[0].clientY-e.touches[1].clientY;lastDist=Math.hypot(dx,dy);}else if(e.touches.length===1){touchMode="pan";startDrag(e.touches[0].clientX,e.touches[0].clientY);}},{passive:true});
wrap.addEventListener("touchmove",function(e){if(touchMode==="pinch"&&e.touches.length===2){const dx=e.touches[0].clientX-e.touches[1].clientX,dy=e.touches[0].clientY-e.touches[1].clientY;const dist=Math.hypot(dx,dy);scale=Math.min(50,Math.max(0.04,scale*(dist/(lastDist||dist))));lastDist=dist;apply();}else if(touchMode==="pan"&&e.touches.length===1)moveDrag(e.touches[0].clientX,e.touches[0].clientY);},{passive:true});
wrap.addEventListener("touchend",function(){touchMode=null;endDrag();});
wrap.addEventListener("contextmenu",function(e){e.preventDefault();});
function updateCoords(cx,cy){const rect=wrap.getBoundingClientRect();const x=Math.floor((cx-rect.left-ox)/scale),y=Math.floor((cy-rect.top-oy)/scale);if(x>=0&&y>=0&&x<SIZE&&y<SIZE)document.getElementById("coords").textContent=String(x).padStart(4,"0")+" x "+String(y).padStart(4,"0");}
function setCursor(){wrap.classList.remove("painting","looking");if(tool==="paint")wrap.classList.add("painting");else if(tool==="lookup")wrap.classList.add("looking");}
wrap.addEventListener("click",async function(e){
  if(dragging||spaceDown)return;
  const rect=wrap.getBoundingClientRect();
  const cx=Math.floor((e.clientX-rect.left-ox)/scale),cy=Math.floor((e.clientY-rect.top-oy)/scale);
  if(cx<0||cy<0||cx>=SIZE||cy>=SIZE)return;
  if(tool==="lookup"){showLookup(cx,cy,e.clientX,e.clientY);return;}
  if(placing)return;placing=true;
  const half=Math.floor(brush/2);
  try{for(let dy=-half;dy<=half;dy++)for(let dx=-half;dx<=half;dx++){const px=cx+dx,py=cy+dy;if(px<0||py<0||px>=SIZE||py>=SIZE)continue;ctx.fillStyle=color;ctx.fillRect(px,py,1,1);try{await api("/place",{method:"POST",json:{x:px,y:py,color:color}});}catch(err){if(String(err.message).indexOf("Failed to fetch")===-1)notify(err.message);}}loadMe();}finally{placing=false;}
});
async function showLookup(x,y,sx,sy){
  const pop=document.getElementById("lookup");pop.style.display="block";pop.style.left=Math.min(sx+12,innerWidth-240)+"px";pop.style.top=Math.min(sy+12,innerHeight-220)+"px";pop.innerHTML="...";
  try{const d=await api("/lookup?x="+x+"&y="+y);if(d.empty){pop.innerHTML="<div class=name>Empty</div><div class=meta>"+x+" x "+y+"</div>";return;}
  let html="<div class=name>@"+d.username+"</div><div class=meta>"+x+" x "+y+"</div><div class=medals>"+(d.is_mod?"MOD ":"")+(d.discord_medal?"DISCORD ":"")+"</div>";
  if(user&&user.is_mod)html+="<div class=acts><button onclick=\"modAct('ban','"+d.username+"')\">Ban</button><button onclick=\"modAct('mute','"+d.username+"')\">Mute</button><button onclick=\"modAct('no_place','"+d.username+"')\">No place</button><button class=danger onclick=\"modAct('delete_account','"+d.username+"')\">Delete</button></div>";
  pop.innerHTML=html;}catch(e){pop.innerHTML="<div class=name>No data</div><div class=meta>"+x+" x "+y+"</div>";}
}
window.modAct=async function(act,target){try{await api("/mod/"+act,{method:"POST",json:{target:target,minutes:act==="no_place"?60:30}});notify("OK");document.getElementById("lookup").style.display="none";}catch(e){notify(e.message);}};
document.addEventListener("click",function(e){const pop=document.getElementById("lookup");if(!pop.contains(e.target)&&e.target.id!=="tool-lookup")pop.style.display="none";});
document.getElementById("tool-paint").onclick=function(){tool="paint";document.querySelectorAll("#tools .tool").forEach(function(t){t.classList.remove("active");});document.getElementById("tool-paint").classList.add("active");setCursor();};
document.getElementById("tool-lookup").onclick=function(){tool="lookup";document.querySelectorAll("#tools .tool").forEach(function(t){t.classList.remove("active");});document.getElementById("tool-lookup").classList.add("active");setCursor();};
function setBrush(n){brush=n;[1,3,5].forEach(function(s){document.getElementById("brush-"+s).classList.toggle("active",s===n);});}
document.getElementById("brush-1").onclick=function(){setBrush(1);};document.getElementById("brush-3").onclick=function(){setBrush(3);};document.getElementById("brush-5").onclick=function(){setBrush(5);};
setBrush(1);setCursor();
function openOv(id){document.getElementById(id).classList.add("show");}function closeOv(id){document.getElementById(id).classList.remove("show");}window.closeOv=closeOv;
document.querySelectorAll(".toggle").forEach(function(t){t.onclick=function(){t.classList.toggle("on");};});
let regMode=false;
function openAuth(reg){regMode=reg;document.getElementById("auth-title").textContent=reg?"Register":"Login";document.getElementById("auth-switch").textContent=reg?"Have account?":"Need account?";openOv("ov-auth");}
document.getElementById("auth-switch").onclick=function(){openAuth(!regMode);};
document.getElementById("auth-go").onclick=async function(){
  const u=document.getElementById("auth-user").value.trim(),p=document.getElementById("auth-pass").value;if(!u||!p)return notify("Fill fields");
  try{if(regMode){const fd=new FormData();fd.append("username",u);fd.append("password",p);const r=await fetch("/register",{method:"POST",body:fd});const d=await r.json();if(!r.ok)throw new Error(d.detail||"Error");notify("Registered!");openAuth(false);}
  else{const fd=new FormData();fd.append("username",u);fd.append("password",p);const r=await fetch("/token",{method:"POST",body:fd});const d=await r.json();if(!r.ok)throw new Error(d.detail||"Login failed");token=d.access_token;localStorage.setItem("pix_token",token);user=d.user;closeOv("ov-auth");loadMe();notify("Welcome "+u);}}catch(e){notify(e.message);}
};
document.getElementById("btn-profile").onclick=async function(){await loadMe();const el=document.getElementById("profile-body");if(!user)el.innerHTML="<p style=color:var(--muted)>Guest</p>";else el.innerHTML="<p><b>@"+user.username+"</b></p><p>Pixels: "+user.pixels_left+" / "+user.limit+"</p>";openOv("ov-profile");};
document.getElementById("btn-mod").onclick=async function(){try{await api("/mod/become",{method:"POST",json:{code:document.getElementById("mod-code").value.trim()}});notify("You are mod!");loadMe();closeOv("ov-profile");}catch(e){notify(e.message);}};
document.getElementById("btn-settings").onclick=function(){openOv("ov-settings");};
document.getElementById("btn-download").onclick=function(){const out=document.createElement("canvas");out.width=SIZE;out.height=SIZE;const o=out.getContext("2d");o.drawImage(bgMap,0,0,SIZE,SIZE);o.drawImage(canvas,0,0);const a=document.createElement("a");a.download="pixpaint.png";a.href=out.toDataURL("image/png");a.click();};
document.getElementById("btn-template").onclick=function(){openOv("ov-template");};
document.getElementById("tpl-file").onchange=function(e){const f=e.target.files[0];if(!f)return;const img=new Image();img.onload=function(){tplCtx.clearRect(0,0,SIZE,SIZE);tplCtx.drawImage(img,0,0,SIZE,SIZE);notify("Template loaded");};img.src=URL.createObjectURL(f);};
document.getElementById("tpl-opacity").oninput=function(e){tplCanvas.style.opacity=(e.target.value/100).toFixed(2);};
document.getElementById("tog-tpl").onclick=function(){this.classList.toggle("on");tplCanvas.style.display=this.classList.contains("on")?"block":"none";};
document.getElementById("btn-tpl-clear").onclick=function(){tplCtx.clearRect(0,0,SIZE,SIZE);notify("Template removed");};
document.getElementById("btn-earn").onclick=async function(){
  if(earnCD>0)return notify("Cooldown: "+earnCD+"s");
  try{const d=await api("/earn/start");const grid=document.getElementById("earn-grid");grid.innerHTML="";d.options.forEach(function(opt){const b=document.createElement("div");b.className="earn-opt";b.textContent=opt;b.onclick=function(){checkEarn(opt,d.session_id);};grid.appendChild(b);});document.getElementById("earn-msg").textContent="";openOv("ov-earn");}
  catch(e){const animals=["cat","dog","tiger","bear","elephant","hippo","crocodile","fox","wolf"];const correct=animals[Math.floor(Math.random()*animals.length)];const opts=animals.slice().sort(function(){return Math.random()-0.5;}).slice(0,9);if(opts.indexOf(correct)<0)opts[0]=correct;const grid=document.getElementById("earn-grid");grid.innerHTML="";opts.forEach(function(opt){const b=document.createElement("div");b.className="earn-opt";b.textContent=opt;b.onclick=function(){if(opt===correct){document.getElementById("earn-msg").textContent="+15 demo";document.getElementById("earn-msg").style.color="var(--green)";}else{document.getElementById("earn-msg").textContent="Wrong: "+correct;document.getElementById("earn-msg").style.color="var(--danger)";}earnCD=opt===correct?7:5;cdTick();};grid.appendChild(b);});openOv("ov-earn");}
};
async function checkEarn(answer,sid){try{const d=await api("/earn/check?session_id="+sid,{method:"POST",json:{answer:answer,correct:""}});const msg=document.getElementById("earn-msg");if(d.ok){msg.textContent="+"+d.added;msg.style.color="var(--green)";earnCD=d.next_cooldown||7;loadMe();setTimeout(function(){closeOv("ov-earn");},1000);}else{msg.textContent="Wrong";msg.style.color="var(--danger)";earnCD=d.next_cooldown||5;}cdTick();}catch(e){notify(e.message);}}
function cdTick(){const t=setInterval(function(){if(--earnCD<=0)clearInterval(t);},1000);}
document.getElementById("btn-clans").onclick=async function(){try{const list=await api("/clans");const el=document.getElementById("clans-body");el.innerHTML=list.length?list.map(function(c){return "<div class=clan-item><div><b>"+c.name+"</b><br><small>"+c.members_count+"/20</small></div><button onclick=\"joinClan('"+c.id+"')\">Join</button></div>";}).join(""):"<p>No clans</p>";}catch(e){document.getElementById("clans-body").innerHTML="<p>Offline</p>";}openOv("ov-clans");};
window.joinClan=async function(id){try{await api("/clan/join",{method:"POST",json:{clan_id:id}});notify("Joined");loadMe();closeOv("ov-clans");}catch(e){notify(e.message);}};
document.getElementById("btn-clan-create").onclick=async function(){const name=document.getElementById("clan-name").value.trim();if(!name)return;try{await api("/clan/create",{method:"POST",json:{name:name}});notify("Created");loadMe();closeOv("ov-clans");}catch(e){notify(e.message);}};
document.getElementById("btn-clear-mod").onclick=function(){openOv("ov-clear");};
document.getElementById("btn-do-clear").onclick=async function(){try{const body={x1:+document.getElementById("cx1").value,y1:+document.getElementById("cy1").value,x2:+document.getElementById("cx2").value,y2:+document.getElementById("cy2").value,full:document.getElementById("cfull").checked};const r=await api("/mod/clear_water",{method:"POST",json:body});notify(r.msg||"Cleared");closeOv("ov-clear");}catch(e){notify(e.message);}};
document.getElementById("btn-chat").onclick=function(){document.getElementById("chat").classList.toggle("show");};
document.querySelectorAll("#chat-tabs button").forEach(function(b){b.onclick=function(){document.querySelectorAll("#chat-tabs button").forEach(function(x){x.classList.remove("active");});b.classList.add("active");channel=b.dataset.ch;loadChat();};});
async function loadChat(){try{const msgs=await api("/chat/history?channel="+channel);const box=document.getElementById("chat-msgs");box.innerHTML=msgs.map(function(m){return "<div class=msg><span class=\"u "+(m.is_mod?"mod":"")+"\">"+m.username+"</span>: "+esc(m.message)+"</div>";}).join("");box.scrollTop=box.scrollHeight;}catch(e){}}
function appendChat(m){if(m.channel!==channel)return;const box=document.getElementById("chat-msgs");box.innerHTML+="<div class=msg><span class=\"u "+(m.is_mod?"mod":"")+"\">"+m.username+"</span>: "+esc(m.message)+"</div>";box.scrollTop=box.scrollHeight;}
document.getElementById("chat-send").onclick=sendChat;document.getElementById("chat-input").onkeydown=function(e){if(e.key==="Enter")sendChat();};
async function sendChat(){const input=document.getElementById("chat-input");const msg=input.value.trim();if(!msg)return;try{await api("/chat",{method:"POST",json:{message:msg,channel:channel}});input.value="";}catch(e){notify(e.message);}}
function esc(s){return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");}
function notify(t){const n=document.getElementById("notify");n.textContent=t;n.classList.add("show");setTimeout(function(){n.classList.remove("show");},2800);}window.notify=notify;
async function loadChunk(){try{const chunk=await api("/canvas/chunk?x1=0&y1=0&x2=512&y2=512");chunk.forEach(function(p){ctx.fillStyle=p.color;ctx.fillRect(p.x,p.y,1,1);});}catch(e){}}
centerView();connectWS();loadMe();loadChunk();loadChat();window.addEventListener("resize",centerView);
bgMap.onerror=function(){bgMap.style.display="none";wrap.style.background="#1e5f8a";};
})();
</script>
</body>
</html>
