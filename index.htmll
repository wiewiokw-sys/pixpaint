(function(){
  var x=document.getElementById("video-mode-x");
  if(!x)return;
  var holdT=null,dragging=false,ox=0,oy=0;
  x.addEventListener("pointerdown",function(e){
    holdT=setTimeout(function(){document.body.classList.remove("video-mode");notify("Video mode off");},2000);
    dragging=true;ox=e.clientX-x.offsetLeft;oy=e.clientY-x.offsetTop;
    try{x.setPointerCapture(e.pointerId);}catch(err){}
  });
  x.addEventListener("pointermove",function(e){
    if(!dragging)return;
    x.style.left=(e.clientX-ox)+"px";x.style.top=(e.clientY-oy)+"px";x.style.right="auto";
  });
  x.addEventListener("pointerup",function(){dragging=false;if(holdT)clearTimeout(holdT);});
})();

// Clan boost button drag + hold
(function(){
  var btn=document.getElementById("clan-boost-btn");
  if(!btn)return;
  var holdT=null,dragging=false,sx=0,sy=0;
  btn.addEventListener("pointerdown",function(e){
    sx=e.clientX;sy=e.clientY;dragging=false;
    holdT=setTimeout(async function(){
      try{
        var r=await api("/clan/boost",{method:"POST"});
        notify("Boost! online="+r.online+" pool="+r.pool);
      }catch(err){notify(err.message);}
    },2000);
    try{btn.setPointerCapture(e.pointerId);}catch(err){}
  });
  btn.addEventListener("pointermove",function(e){
    if(Math.hypot(e.clientX-sx,e.clientY-sy)>8){
      if(holdT){clearTimeout(holdT);holdT=null;}
      dragging=true;
      btn.style.left=e.clientX-26+"px";btn.style.top=e.clientY-26+"px";btn.style.right="auto";btn.style.bottom="auto";
    }
  });
  btn.addEventListener("pointerup",function(){if(holdT)clearTimeout(holdT);dragging=false;});
})();

// Show overlord boost if leader of 20+ clan
async function syncClanBoost(){
  var btn=document.getElementById("clan-boost-btn");
  if(!btn||!user||!user.clan_id){if(btn)btn.style.display="none";return;}
  try{
    var info=await api("/clan/info");
    if(info&&info.leader===user.username&&(info.members||[]).length>=20){
      btn.style.display="grid";
    }else btn.style.display="none";
  }catch(e){btn.style.display="none";}
}

