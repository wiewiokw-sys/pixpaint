    Mod:"<path d='M12 1L3 5v6c0 5.5 3.8 10.7 9 12 5.2-1.3 9-6.5 9-12V5l-9-4zm0 2.2l7 3.1v4.7c0 4.4-2.9 8.5-7 9.7-4.1-1.2-7-5.3-7-9.7V6.3l7-3.1z'/>",
    Clan:"<path d='M16 11c1.7 0 3-1.3 3-3s-1.3-3-3-3-3 1.3-3 3 1.3 3 3 3zM8 11c1.7 0 3-1.3 3-3S9.7 5 8 5 5 6.3 5 8s1.3 3 3 3zm0 2c-2.3 0-7 1.2-7 3.5V19h14v-2.5C15 14.2 10.3 13 8 13zm8 0c-.3 0-.6 0-1 .1 1.2.9 2 2.1 2 3.4V19h6v-2.5c0-2.3-4.7-3.5-7-3.5z'/>",
    Streak:"<path d='M7 2v11h3v9l7-12h-4l4-8z'/>",
    "2M":"<text x='3' y='16' font-size='11' font-weight='700'>2</text><rect x='12' y='6' width='8' height='8' fill='none' stroke='currentColor' stroke-width='1.6'/>",
    YouTube:"<path d='M10 8.5v7l6-3.5-6-3.5z'/><rect x='3' y='5' width='18' height='14' rx='3' fill='none' stroke='currentColor'/>",
    "Day #1":"<path d='M19 4h-1V2h-2v2H8V2H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10z'/>",
    "All #1":"<path d='M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm.5 13H11v-2h1.5v2zm0-3.5H11V7h1.5v4.5z'/>"
  };
  var path=icons[title]||icons.Account;
  return "<div class=\"medal "+(on?"on":"")+"\"><div class=ico><svg viewBox='0 0 24 24'>"+path+"</svg></div><small>"+title+"</small><small>"+bonus+"</small></div>";
}
window.openSwipe=function(){
  var slots=JSON.parse(localStorage.getItem("pix_slots")||"[]");
  var html="<h3 style='margin-bottom:8px'>Accounts</h3>";
  html+="<p style='font-size:12px;color:var(--muted);margin-bottom:8px'>Main + up to 2 extra. Create = TWINK (÷3). Link = normal account.</p>";
  html+="<button onclick=\"switchSlot('main')\">Main @"+(user&&user.username||"?")+"</button>";
  slots.forEach(function(s,i){
    html+="<div style='margin-top:6px;display:flex;gap:6px;align-items:center'><button style='flex:1' onclick=\"switchSlot("+i+")\">@"+s.username+(s.twink?" TWINK":"")+"</button></div>";
  });
  if(slots.length<2){
    html+="<div class='row' style='margin-top:10px'><button onclick='createTwinkSlot()'>Create TWINK</button><button class='ghost' onclick='linkSlot()'>Link account</button></div>";
  }
  html+="<div class='row' style='margin-top:8px'><button class='ghost' onclick=\"closeOv('ov-swipe')\">Close</button></div>";
  var ov=document.getElementById("ov-swipe");
  if(!ov){
    ov=document.createElement("div");ov.id="ov-swipe";ov.className="overlay";
    ov.innerHTML="<div class='modal' id='swipe-body'></div>";
    document.body.appendChild(ov);
  }
  document.getElementById("swipe-body").innerHTML=html;
  openOv("ov-swipe");
};
window.createTwinkSlot=async function(){
  try{
    var slots=JSON.parse(localStorage.getItem("pix_slots")||"[]");
    if(slots.length>=2)return notify("Max 2");
    var r=await api("/accounts/create_twink",{method:"POST",json:{slot:slots.length+1}});
    slots.push({username:r.user.username,token:r.access_token,twink:true});
    localStorage.setItem("pix_slots",JSON.stringify(slots));
    notify("Twink created @"+r.user.username);
    openSwipe();
  }catch(e){notify(e.message);}
};
window.linkSlot=async function(){
  var u=prompt("Username to link:");
  var p=prompt("Password:");
  if(!u||!p)return;
  try{
    var slots=JSON.parse(localStorage.getItem("pix_slots")||"[]");
    if(slots.length>=2)return notify("Max 2");
    var r=await api("/accounts/link",{method:"POST",json:{username:u,password:p}});
    slots.push({username:r.user.username,token:r.access_token,twink:!!r.is_twink});
    localStorage.setItem("pix_slots",JSON.stringify(slots));
    notify("Linked @"+r.user.username);
    openSwipe();
  }catch(e){notify(e.message);}
};
window.switchSlot=function(i){
  if(i==="main"){
    var mt=localStorage.getItem("pix_main_token")||token;
    if(mt){token=mt;localStorage.setItem("pix_token",mt);}
  }else{
    var slots=JSON.parse(localStorage.getItem("pix_slots")||"[]");
    var s=slots[i];if(!s)return;
    if(!localStorage.getItem("pix_main_token")&&token)localStorage.setItem("pix_main_token",token);
    token=s.token;localStorage.setItem("pix_token",token);
  }
  closeOv("ov-swipe");closeOv("ov-profile");
  loadMe();loadTemplatesServer();notify("Switched");
};
window.chg=async function(field){
  var label=field==="username"?"@username (3-20, a-z 0-9 _)":field;
  var v=prompt("New "+label+":");
  if(v===null||v==="")return;
  try{
    var body={};body[field]=v;
    var r=await api("/profile/update",{method:"POST",json:body});
    if(r&&r.access_token){
      token=r.access_token;
      localStorage.setItem("pix_token", token);
    }
    if(r&&r.user)user=r.user;
    if(r&&r.username_changed){
      notify("Username → @"+r.login_as+" (token refreshed)");
    }else{
      notify("Updated");
    }
    await loadMe();
    document.getElementById("btn-profile").click();
  }catch(e){notify(e.message||String(e));}
};
document.getElementById("btn-av").onclick=async function(){try{await api("/profile/update",{method:"POST",json:{avatar_color:+document.getElementById("av-color").value}});notify("Avatar saved");}catch(e){notify(e.message);}};
document.getElementById("btn-logout").onclick=function(){token=null;localStorage.removeItem("pix_token");user=null;closeOv("ov-profile");loadMe();};

