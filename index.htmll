document.querySelectorAll("#chat-tabs button").forEach(function(b){b.onclick=function(){document.querySelectorAll("#chat-tabs button").forEach(function(x){x.classList.remove("active");});b.classList.add("active");channel=b.dataset.ch;loadChat();};});
async function loadChat(){
  try{var msgs=await api("/chat/history?channel="+channel);var box=document.getElementById("chat-msgs");
    box.innerHTML=msgs.map(function(m){return chatHTML(m);}).join("");box.scrollTop=box.scrollHeight;
  }catch(e){}
}
function chatHTML(m){
  var col=AV_COLORS[m.avatar_color||0]||AV_COLORS[0];
  var letter=((m.display_name||m.username||"?")[0]||"?").toUpperCase();
  var t=(m.created_at||"").slice(11,16);
  return "<div class=msg><div class=av style='background:"+col+"'>"+letter+"</div><div class=body><span class='u "+(m.is_mod?"mod":"")+"'>"+(m.display_name||m.username)+"</span><span class=t>"+t+"</span><br>"+esc(m.message)+"</div></div>";
}
function appendChat(m){if(m.channel!==channel)return;var box=document.getElementById("chat-msgs");box.innerHTML+=chatHTML(m);box.scrollTop=box.scrollHeight;}
function markChatNew(){
  var chatEl=document.getElementById("chat");
  var open=chatEl&&(chatEl.classList.contains("show")||chatEl.style.display==="flex");
  if(open)return;
  var tc2=document.getElementById("tool-chat");if(tc2)tc2.classList.add("has-new");
  var cd=document.getElementById("chat-dot");if(cd)cd.style.display="block";
}
var chatSending = false;

document.getElementById("chat-send").onclick = function(e){
  e.preventDefault();
  e.stopPropagation();
  sendChat();
};
document.getElementById("chat-input").onkeydown = function(e){
  if(e.key==="Enter"){
    e.preventDefault();
    sendChat();
  }
};

async function sendChat(){
  if(chatSending)return;
  var input = document.getElementById("chat-input");
  var btn = document.getElementById("chat-send");
  var msg = (input.value || "").trim();
  if(!msg)return;

  // Clear immediately so laggy users don't spam 2-9 messages
  input.value = "";
  chatSending = true;
  if(btn){btn.disabled=true;btn.style.opacity="0.5";}

  try{
    var r = await api("/chat",{method:"POST",json:{message:msg,channel:channel}});
    if(r && r.silent){notify(r.msg||"OK");}
  }catch(e){
    var m = String(e.message||e);
    if(m.indexOf("MUTED_BY:")===0){
      var by="mod",min=1;
      try{var p=m.split("|");by=p[0].split(":")[1];min=p[1].split(":")[1];}catch(x){}
      showMuteBlock(by,min);
    }else{
      notify(m);
    }
  }finally{
    chatSending = false;
    if(btn){btn.disabled=false;btn.style.opacity="";}
    try{input.focus();}catch(x){}
  }
}
function showMuteBlock(by,min){
  var el=document.getElementById("auth-block");
  if(!el)return;
  el.innerHTML="YOU ARE MUTED<br><small>by "+by+" · ~"+min+" min left</small>";
  el.classList.add("show");
  setTimeout(function(){el.classList.remove("show");el.innerHTML="YOU ARE NOT AUTHORIZED<br><small style=\"font-size:14px;font-weight:400;opacity:.8\">Open Profile to register / login</small>";},3500);
}
