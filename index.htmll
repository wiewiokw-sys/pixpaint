};
syncTerrainBtn();

function timeAgo(ts){
  if(!ts)return "?";
  var sec=Math.max(0,Math.floor((Date.now()-ts)/1000));
  if(sec<60)return sec+"s ago";
  var min=Math.floor(sec/60);
  if(min<60)return min+" min ago";
  var hr=Math.floor(min/60);
  if(hr<48)return hr+" h ago";
  return hr+" h ago";
}
document.getElementById("tool-radar").onclick=async function(){
  try{
    var d=await api("/radar");
    if(d&&d.last&&d.last.x!=null){
      lastRemote={x:d.last.x,y:d.last.y,t:d.last.t?new Date(d.last.t).getTime():Date.now(),user:d.last.username};
    }else if(d&&d.x!=null){
      lastRemote={x:d.x,y:d.y,t:d.t?new Date(d.t).getTime():Date.now(),user:d.username};
    }
    if(d&&d.recent&&d.recent.length){
      var names=[];
      d.recent.forEach(function(r){if(r.username&&names.indexOf(r.username)<0)names.push(r.username);});
      if(names.length)notify("Last 2 min: "+names.slice(0,8).map(function(n){return "@"+n;}).join(" "));
    }
  }catch(e){}
  if(!lastRemote){notify("No recent activity (2 min)");return;}
  var r=wrap.getBoundingClientRect();
  var tx=lastRemote.x,ty=lastRemote.y;
  scale=Math.max(scale,8);
  ox=r.width/2-tx*scale-scale/2;
  oy=r.height/2-ty*scale-scale/2;
  apply();
  remoteGlow(tx,ty,lastRemote.user);
  var who=lastRemote.user?(" @"+lastRemote.user):"";
  var ts=typeof lastRemote.t==="number"?lastRemote.t:(lastRemote.t?new Date(lastRemote.t).getTime():Date.now());
  notify("Radar → "+tx+", "+ty+who+" · "+timeAgo(ts)+" (TTL 2m)");
};
function bindBuildBtns(){
  var bok=document.getElementById("build-ok");if(bok)bok.onclick=function(){confirmDraft();};
  var bc=document.getElementById("build-cancel");if(bc)bc.onclick=function(){clearDraft();notify("Cleared");updateDraftUI();};
  var br=document.getElementById("build-rate");
  if(br){br.addEventListener("input",function(){br.dataset.user="1";});}
}
bindBuildBtns();
document.getElementById("tool-pencil").onclick=function(){
  pencilMode=!pencilMode;
  this.style.background=pencilMode?"#14532d":"";
