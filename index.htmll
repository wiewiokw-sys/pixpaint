function showSpend(n){
  try{
    var pc=document.getElementById("pal-cost");
    var pg=document.getElementById("palette-page");
    var have=user?(user.pixels_left||0):0;
    if(pc){
      pc.style.display="inline-block";
      pc.textContent="-"+n+"/"+have;
      if(pg && !(window.draftCount|0)) pg.style.display="none";
      clearTimeout(pc._t);
      pc._t=setTimeout(function(){
        if(!(window.draftCount|0)){pc.style.display="none";if(pg)pg.style.display="inline";}
      },1500);
    }
  }catch(e){}
}
function flashHudDenied(){
  var t=document.getElementById("hud");
  if(!t)return;
  t.classList.add("flash-red");
  setTimeout(function(){t.classList.remove("flash-red");t.style.background="";},500);
}
