document.getElementById("btn-records").onclick=function(){document.getElementById("menu").classList.remove("show");loadLB("daily");openOv("ov-records");};
document.getElementById("lb-daily").onclick=function(){loadLB("daily");};
document.getElementById("lb-all").onclick=function(){loadLB("alltime");};
async function loadLB(period){
  try{
    var list=await api("/leaderboard?period="+period);
    document.getElementById("lb-body").innerHTML=list.length?list.map(function(r){
      var admin="";
      if(user&&user.is_mod){
        admin="<div style='display:flex;gap:4px;margin-top:4px;flex-wrap:wrap'>"+
          "<button style='font-size:10px;padding:2px 6px' onclick=\"lbZero('"+r.username+"')\">Zero</button>"+
          "<button style='font-size:10px;padding:2px 6px' onclick=\"lbSet('"+r.username+"','"+period+"')\">Edit</button>"+
          "<button style='font-size:10px;padding:2px 6px;background:var(--danger);color:#fff' onclick=\"lbWipe('"+r.username+"')\">Ban+Wipe</button></div>";
      }
      return "<div class=lb-row><span class=r>#"+r.rank+"</span><span>"+r.display_name+" @"+r.username+admin+"</span><span>"+r.score+"</span></div>";
    }).join(""):"<p>Empty</p>";
  }catch(e){document.getElementById("lb-body").innerHTML="Error";}
}

// Earn
document.getElementById("coin-btn").onclick=async function(){
  if(!user){showAuthBlock();return;}
  if(earnCD>0)return notify("Cooldown "+Math.ceil(earnCD)+"s");
  try{
    var d=await api("/earn/start");
    setCoinMode(d.mode||"animal");
    var q=document.getElementById("earn-q");
    var hint=document.getElementById("earn-hint");
    var g=document.getElementById("earn-grid");g.innerHTML="";
    var chanceLine="Chance: "+(d.chance||100)+"% · Reward ~"+(d.reward||15);
    if(d.mode==="math"){
      q.textContent=d.question||"?";
      if(hint)hint.textContent="Solve · "+chanceLine;
      var inp=document.createElement("input");inp.type="number";inp.style.cssText="width:100%;padding:12px;font-size:20px;text-align:center;border-radius:8px;border:1px solid var(--border);background:#0b0e14;color:#fff";
      var ok=document.createElement("button");ok.textContent="OK";ok.style.marginTop="8px";
      ok.onclick=function(){checkEarn(inp.value,d.session_id);};
      g.appendChild(inp);g.appendChild(ok);
    }else if(d.mode==="color"){
      q.innerHTML='<div style="width:64px;height:64px;border-radius:12px;margin:0 auto;background:'+(d.color||"#fff")+';border:2px solid #fff"></div>';
      if(hint)hint.textContent="Pick the color · "+chanceLine;
      (d.options||[]).forEach(function(opt){
        var b=document.createElement("div");b.className="earn-opt";
        b.style.background=opt;b.style.minHeight="36px";b.textContent="";
        b.onclick=function(){checkEarn(opt,d.session_id);};
        g.appendChild(b);
      });
    }else{
      q.textContent=(d.animal||"?").toUpperCase();
      if(hint)hint.textContent="Choose the animal · "+chanceLine;
      (d.options||[]).forEach(function(opt){var b=document.createElement("div");b.className="earn-opt";b.textContent=opt;b.onclick=function(){checkEarn(opt,d.session_id);};g.appendChild(b);});
    }
    var em=document.getElementById("earn-msg");if(em)em.textContent=chanceLine;
    openOv("ov-earn");
  }catch(e){notify(e.message);}
};
async function checkEarn(answer,sid){
  try{
    var d=await api("/earn/check?session_id="+sid,{method:"POST",json:{answer:answer}});
    var m=document.getElementById("earn-msg");
    if(d.ok){m.textContent="+"+d.added+" (streak "+d.streak+")";m.style.color="var(--green)";earnCD=15;earnCDMax=15;updateCoinUI();loadMe();setTimeout(function(){closeOv("ov-earn");},900);}
    else{m.textContent=d.msg||("Wrong: "+(d.correct||""));m.style.color="var(--danger)";earnCD=15;earnCDMax=15;updateCoinUI();}
  }catch(e){notify(e.message);}
}

// Clans
document.getElementById("btn-clans").onclick=async function(){
  document.getElementById("menu").classList.remove("show");
  var body=document.getElementById("clans-body");body.innerHTML="...";
  openOv("ov-clans");
  try{
    var info=await api("/clan/info");
    if(info.empty){body.innerHTML="<p style=color:var(--muted)>Not in a clan</p>";return;}
    var h="<div style=padding:10px;border:1px solid var(--border);border-radius:10px;margin-bottom:10px><b>"+info.name+"</b> @"+info.tag+"<br>Leader: "+info.leader+"</div>";
    (info.members||[]).forEach(function(m){
      var nameStyle=m.is_leader?"color:#fbbf24;font-weight:700":"";
      h+="<div style=padding:8px;border:1px solid var(--border);border-radius:8px;margin-bottom:6px;font-size:12px>";
      h+="<span style="+nameStyle+">"+m.display_name+" @"+m.username+(m.is_leader?" (owner)":"")+"</span>";
      h+="<br>Pixels: "+m.pixels_left+" · Placed: "+m.pixels_placed;
      if(user&&user.username===info.leader&&!m.is_leader){
        h+="<br><button onclick=\"clanKick('"+m.username+"')\">Kick</button> ";
        h+="<button onclick=\"clanBan('"+m.username+"')\">Ban 60m</button>";
      }
      h+="</div>";
    });
    h+="<button class=danger onclick=\"clanLeave()\" style=margin-top:8px>Leave clan</button>";
    body.innerHTML=h;
  }catch(e){body.innerHTML="<p>Error</p>";}
};
window.clanKick=async function(t){try{await api("/clan/kick",{method:"POST",json:{target:t}});notify("Kicked");document.getElementById("btn-clans").click();}catch(e){notify(e.message);}};
window.clanBan=async function(t){try{await api("/clan/ban",{method:"POST",json:{target:t,minutes:60}});notify("Banned 60m");document.getElementById("btn-clans").click();}catch(e){notify(e.message);}};
window.clanLeave=async function(){try{await api("/clan/leave",{method:"POST"});notify("Left");loadMe();closeOv("ov-clans");}catch(e){notify(e.message);}};

document.getElementById("btn-clan-search").onclick=async function(){
  try{var c=await api("/clan/search?tag="+encodeURIComponent(document.getElementById("clan-search-tag").value.trim()));
    document.getElementById("clans-body").innerHTML="<div style='padding:8px;border:1px solid var(--border);border-radius:8px'><b>"+c.name+"</b> @"+c.tag+"<br>"+c.members_count+"/20<br><button onclick=\"joinClan('"+c.tag+"')\">Join</button></div>";
  }catch(e){notify(e.message);}
};
window.joinClan=async function(tag){try{await api("/clan/join",{method:"POST",json:{tag:tag}});notify("Joined");loadMe();closeOv("ov-clans");}catch(e){notify(e.message);}};
document.getElementById("btn-clan-create").onclick=async function(){
  try{await api("/clan/create",{method:"POST",json:{name:document.getElementById("clan-name").value.trim(),tag:document.getElementById("clan-tag").value.trim()}});notify("Created");loadMe();closeOv("ov-clans");}catch(e){notify(e.message);}
};

// Templates
async function saveTemplatesServer(){
  if(!token)return;
  try{
    var payload=[];
    for(var i=0;i<templates.length;i++){
      var t=templates[i];
      var c=document.createElement("canvas");c.width=t.w;c.height=t.h;
      c.getContext("2d").drawImage(t.img,0,0,t.w,t.h);
      payload.push({x:t.x,y:t.y,w:t.w,h:t.h,label:t.label||"",data_url:c.toDataURL("image/png")});
    }
    await api("/templates",{method:"POST",json:{templates:payload}});
  }catch(e){}
}
async function loadTemplatesServer(){
  if(!token)return;
  try{
    var list=await api("/templates");
    if(!list||!list.length)return;
    templates=[];
    for(var i=0;i<list.length;i++){
      (function(t){
        var img=new Image();
        img.onload=function(){templates.push({img:img,x:t.x,y:t.y,w:t.w,h:t.h,label:t.label||""});redrawTemplates();};
        img.src=t.data_url;
      })(list[i]);
    }
  }catch(e){}
}
document.getElementById("btn-template").onclick=function(){document.getElementById("menu").classList.remove("show");renderTplList();openOv("ov-template");};

function renderTplList(){
  var el=document.getElementById("tpl-list");
  if(!templates.length){el.innerHTML="<p style=\"color:var(--muted);font-size:13px\">No templates</p>";return;}
  el.innerHTML=templates.map(function(t,i){
    var lab=t.label||("T"+i);
    return "<div style=\"padding:8px;border:1px solid var(--border);border-radius:8px;margin-bottom:6px;font-size:12px\">"+
      "<div style=\"display:flex;align-items:center;gap:6px;margin-bottom:4px\"><b>"+lab+"</b> @ "+t.x+","+t.y+" "+t.w+"x"+t.h+
      "<span style=\"margin-left:auto\">"+
      "<button onclick=\"tplUp("+i+")\" style=\"padding:2px 6px\">↑</button> "+
      "<button onclick=\"tplDown("+i+")\" style=\"padding:2px 6px\">↓</button> "+
      "<button onclick=\"editTpl("+i+")\" style=\"padding:2px 6px\">Edit</button> "+"<button onclick=\"pubTpl("+i+")\" style=\"padding:2px 6px\">Publish</button> "+
      "<button onclick=\"delTpl("+i+")\" style=\"padding:2px 6px;background:var(--danger);color:#fff;border:none;border-radius:4px\">Del</button> "+((user&&(user.is_mod||user.god_mode))?("<button onclick=\"buildTpl("+i+")\" style=\"padding:2px 8px;background:#eab308;color:#111;border:none;border-radius:4px;font-weight:700\">BUILD</button>"):"")+"</span></div></div>";
  }).join("");
}
window.buildTpl=async function(i){
  if(!user||!(user.is_mod||user.god_mode))return notify("Mods only");
  var t=templates[i];if(!t||!t.img)return;
  if(!confirm("BUILD template — auto place all pixels?"))return;
  notify("Building...");
  var batch=[];
  for(var yy=0;yy<t.h;yy++){
    for(var xx=0;xx<t.w;xx++){
      var col=null;
      try{
        _tplSampleG.clearRect(0,0,1,1);
        _tplSampleG.drawImage(t.img,xx*(t.img.width/t.w),yy*(t.img.height/t.h),Math.max(0.01,t.img.width/t.w),Math.max(0.01,t.img.height/t.h),0,0,1,1);
        var d=_tplSampleG.getImageData(0,0,1,1).data;
        if(d[3]<20)continue;
        col=nearestPalette("#"+[d[0],d[1],d[2]].map(function(v){return v.toString(16).padStart(2,"0");}).join(""));
      }catch(e){continue;}
      if(!col)continue;
      var px=t.x+xx,py=t.y+yy;
      if(localPixelCache[px+","+py]===col)continue;
      batch.push({x:px,y:py,color:col});
    }
  }
  if(!batch.length)return notify("Nothing to place");
  var placed=0;placingLocal=true;
  try{
    for(var s=0;s<batch.length;s+=80){
      var chunk=batch.slice(s,s+80);
      try{
        if(chunk.length===1)await api("/place",{method:"POST",json:chunk[0]});
        else await api("/place_batch",{method:"POST",json:{pixels:chunk}});
        chunk.forEach(function(p){phantomPixel(p.x,p.y,p.color);});
        placed+=chunk.length;
      }catch(e){notify(e.message);break;}
    }
    notify("Built "+placed);loadMe();loadStats();
  }finally{setTimeout(function(){placingLocal=false;},300);}
};
window.tplUp=function(i){if(i<=0)return;var t=templates[i];templates[i]=templates[i-1];templates[i-1]=t;redrawTemplates();renderTplList();saveTemplatesServer();};
window.tplDown=function(i){if(i>=templates.length-1)return;var t=templates[i];templates[i]=templates[i+1];templates[i+1]=t;redrawTemplates();renderTplList();saveTemplatesServer();};
window.editTpl=function(i){
  var t=templates[i];
  document.getElementById("tpl-x").value=t.x;
  document.getElementById("tpl-y").value=t.y;
  document.getElementById("tpl-w").value=t.w;
  var lab=document.getElementById("tpl-label");if(lab)lab.value=t.label||"";
  window._tplEdit=i;
  window._tplImg=t.img;
  notify("Edit — change and press Add");
};
window.pubTpl=async function(i){
  var t=templates[i];
  if(!token)return notify("Login");
  if(!user||!user.is_mod)return notify("Only moderators can publish templates");
  try{
    var c=document.createElement("canvas");c.width=t.w;c.height=t.h;
    c.getContext("2d").drawImage(t.img,0,0,t.w,t.h);
    await api("/templates/publish",{method:"POST",json:{label:(t.label||"tpl").slice(0,20),x:t.x,y:t.y,w:t.w,h:t.h,data_url:c.toDataURL("image/png")}});
    notify("Published");
  }catch(e){notify(e.message);}
};

window.delTpl=function(i){templates.splice(i,1);redrawTemplates();renderTplList();saveTemplatesServer();};
document.getElementById("tpl-file").onchange=function(e){var f=e.target.files[0];if(!f)return;var img=new Image();img.onload=function(){window._tplImg=img;notify("Loaded "+img.width+"x"+img.height);};img.src=URL.createObjectURL(f);};
document.getElementById("btn-tpl-apply").onclick=function(){
  var x=+document.getElementById("tpl-x").value||0,y=+document.getElementById("tpl-y").value||0,w=+document.getElementById("tpl-w").value||0;
  var label=(document.getElementById("tpl-label")?document.getElementById("tpl-label").value:"").slice(0,10);
  if(typeof window._tplEdit==="number"){
    var old=templates[window._tplEdit];
    var img=window._tplImg||old.img;
    var h;if(w<=0){w=img.width;h=img.height;}else h=Math.round(img.height*(w/img.width));
    templates[window._tplEdit]={img:img,x:x,y:y,w:w,h:h,label:label||old.label};
    window._tplEdit=undefined;notify("Updated");
  }else{
    if(!window._tplImg)return notify("Choose file");
    if(templates.length>=1)return notify("Max 1 template");
    var h2;if(w<=0){w=window._tplImg.width;h2=window._tplImg.height;}else h2=Math.round(window._tplImg.height*(w/window._tplImg.width));
    templates.push({img:window._tplImg,x:x,y:y,w:w,h:h2,label:label});
    notify("Added");
  }
  redrawTemplates();renderTplList();saveTemplatesServer();
};
var blinkOn=true;
setInterval(function(){blinkOn=!blinkOn;if(templates.length)redrawTemplates();},1000);
function redrawTemplates(){
  tplCtx.clearRect(0,0,SIZE,SIZE);
  // lower index = higher priority visually last? User: first template is highest. Draw first on top = draw reverse
  for(var i=templates.length-1;i>=0;i--){
    var t=templates[i];
    tplCtx.drawImage(t.img,t.x,t.y,t.w,t.h);
  }
  // blink markers (display only, not in sampleTemplate - markers drawn after)
  templates.forEach(function(t){
    tplCtx.fillStyle=blinkOn?"#ff0000":"#0088ff";
    tplCtx.fillRect(t.x,t.y,1,1);
  });
  tplC.style.opacity=(document.getElementById("tpl-opacity").value/100).toFixed(2);
}
document.getElementById("tpl-opacity").oninput=function(){tplC.style.opacity=(this.value/100).toFixed(2);};
document.getElementById("btn-tpl-clear").onclick=function(){templates=[];tplCtx.clearRect(0,0,SIZE,SIZE);renderTplList();};

// Screenshot
document.getElementById("btn-tem-dl").onclick=function(){
  document.getElementById("menu").classList.remove("show");
  openOv("ov-temdl");
  notify("Loading...");
  setTimeout(function(){loadTemDl("pub");},500);
};
document.getElementById("temdl-tab-pub").onclick=function(){loadTemDl("pub");};
document.getElementById("temdl-tab-mine").onclick=function(){loadTemDl("mine");};
async function loadTemDl(tab){
  var body=document.getElementById("temdl-body");
  if(tab==="mine"){
    body.innerHTML=templates.length?templates.map(function(t,i){
      return "<div style=\"padding:8px;border:1px solid var(--border);border-radius:8px;margin-bottom:6px;font-size:12px\"><b>"+(t.label||("T"+i))+"</b> @ "+t.x+","+t.y+
        "<br><button onclick=\"editTpl("+i+");closeOv('ov-temdl');openOv('ov-template')\">Edit</button> "+
        "<button onclick=\"delTpl("+i+");loadTemDl('mine')\">Del</button></div>";
    }).join(""):"<p>No installed templates</p>";
    return;
  }
  body.innerHTML="Loading...";
  try{
    var list=await api("/templates/public");
    body.innerHTML=list.length?list.map(function(t){
      var d=(t.created||"").toString().slice(0,10);
      return "<div style=\"padding:8px;border:1px solid var(--border);border-radius:8px;margin-bottom:6px;font-size:12px\">"+
        "<b>"+(t.label||"tpl")+"</b> — @"+t.author+" · "+d+" · ↓"+(t.installs||0)+
        "<br>"+t.w+"x"+t.h+" @ "+t.x+","+t.y+
        "<br><button onclick=\"installPub('"+t.id+"')\">Install</button> "+
        ((user&&(user.is_mod||user.username===t.author))?("<button onclick=\"delPubTpl('"+t.id+"')\" style=\"background:var(--danger);color:#fff;border:none;border-radius:4px;padding:2px 6px\">Del</button>"):"")+
        "</div>";
    }).join(""):"<p>No public templates</p>";
  }catch(e){body.innerHTML="Error";}
}
window.delPubTpl=async function(id){
  if(!confirm("Delete this public template?"))return;
  try{await api("/templates/delete_public",{method:"POST",json:{tid:id}});notify("Deleted");loadTemDl("pub");}catch(e){notify(e.message);}
};
window.installPub=async function(id){
  try{
    var list=await api("/templates/public");
    var t=list.find(function(x){return x.id===id;});
    if(!t)return notify("Not found");
    if(templates.length>=1)return notify("Max 1 template");
    var img=new Image();
    img.onload=async function(){
      templates.push({img:img,x:t.x,y:t.y,w:t.w,h:t.h,label:t.label});
      redrawTemplates();saveTemplatesServer();
      await api("/templates/install",{method:"POST",json:{tid:id}});
      notify("Installed");
    };
    img.src=t.data_url;
  }catch(e){notify(e.message);}
};
document.getElementById("btn-download").onclick=function(){document.getElementById("menu").classList.remove("show");openOv("ov-shot");};
document.getElementById("btn-do-shot").onclick=function(){
  var r=wrap.getBoundingClientRect();
  var sx=Math.max(0,Math.floor((-ox)/scale)),sy=Math.max(0,Math.floor((-oy)/scale));
  var sw=Math.min(SIZE-sx,Math.ceil(r.width/scale)),sh=Math.min(SIZE-sy,Math.ceil(r.height/scale));
  var out=document.createElement("canvas");out.width=sw;out.height=sh;var o=out.getContext("2d");
  o.drawImage(bgMap,sx,sy,sw,sh,0,0,sw,sh);o.drawImage(canvas,sx,sy,sw,sh,0,0,sw,sh);
  var a=document.createElement("a");a.download="PixPaint_"+Date.now()+".png";a.href=out.toDataURL("image/png");a.click();
  closeOv("ov-shot");notify("Saved — put in PixPaint folder");
};

