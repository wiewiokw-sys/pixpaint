document.getElementById("btn-mod").onclick=async function(){try{await api("/mod/become",{method:"POST",json:{code:document.getElementById("mod-code").value.trim()}});notify("You are mod");loadMe();closeOv("ov-settings");}catch(e){notify(e.message);}};

