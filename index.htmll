window.lbZero=async function(u){
  if(!confirm("Zero score for @"+u+"?"))return;
  try{await api("/mod/lb_zero",{method:"POST",json:{target:u}});notify("Zeroed");document.getElementById("btn-records").click();}catch(e){notify(e.message);}
};
window.lbSet=async function(u,period){
  var s=prompt("New score for @"+u);
  if(s==null)return;
  try{await api("/mod/lb_set",{method:"POST",json:{target:u,score:+s,period:period||"alltime"}});notify("Updated");document.getElementById("btn-records").click();}catch(e){notify(e.message);}
};
window.lbWipe=async function(u){
  if(!confirm("WIPE ALL data for @"+u+"?"))return;
  try{await api("/mod/wipe_user",{method:"POST",json:{target:u,reason:"lb wipe"}});notify("Wiped");document.getElementById("btn-records").click();}catch(e){notify(e.message);}
};

function safeBoot(){
  try{centerView();}catch(e){console.warn(e);}
  // recenter after layout
  setTimeout(function(){try{centerView();}catch(e){}}, 50);
  setTimeout(function(){try{centerView();}catch(e){}}, 300);
  try{updateDraftUI();}catch(e){}
  try{connectWS();}catch(e){}
  try{loadMe();}catch(e){}
  try{loadStats();}catch(e){}
  try{loadZones();}catch(e){}
  try{updateCoinUI();}catch(e){}
  try{loadTemplatesServer();}catch(e){}
  try{loadCustomColors();}catch(e){}
  try{loadPixels();}catch(e){console.warn(e);}
  (async function bootHealth(){
    try{
      var h=await api("/health");
      console.log("health", h);
      var mid=document.getElementById("mid-px");
      if(mid && h.pixels_in_db!=null)mid.textContent=fmtN(h.pixels_in_db);
      if(!h.mongo){if(typeof notify==="function")notify("DB offline — data empty");}
    }catch(e){console.warn("health fail", e);}
  })();
}
if(document.readyState==="loading")document.addEventListener("DOMContentLoaded", safeBoot);
else safeBoot();
