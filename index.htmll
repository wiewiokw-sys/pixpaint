// ===== BIG UPDATE FEATURES =====
(function(){
  // Boot screen 4s
  var boot=document.getElementById("boot-screen");
  if(boot){
    var name="PixPaint";
    var colors=["#ef4444","#f97316","#eab308","#22c55e","#3b82f6","#8b5cf6","#ec4899","#14b8a6"];
    var logo=document.getElementById("boot-logo");
    logo.innerHTML=name.split("").map(function(ch,i){
      return '<span style="color:'+colors[i%colors.length]+';animation-delay:'+(i*0.08)+'s">'+ch+'</span>';
    }).join("");
    var bar=document.getElementById("boot-bar-wrap");
    var N=24;
    for(var i=0;i<N;i++){
      var c=document.createElement("div");
      c.className="cube";
      c.style.background=colors[i%colors.length];
      bar.appendChild(c);
    }
    var cubes=bar.querySelectorAll(".cube");
    var t0=Date.now(), DUR=4000;
    function tick(){
      var p=Math.min(1,(Date.now()-t0)/DUR);
      var n=Math.floor(p*N);
      for(var i=0;i<N;i++)cubes[i].style.opacity=i<n?"1":"0.15";
      if(p<1)requestAnimationFrame(tick);
      else setTimeout(function(){boot.classList.add("hide");setTimeout(function(){boot.remove();},500);showRules();},200);
    }
    requestAnimationFrame(tick);
  }else showRules();

  function showRules(){
    var ov=document.getElementById("rules-ov");
    var btn=document.getElementById("rules-ok");
    if(!ov||!btn)return;
    ov.classList.add("show");
    btn.disabled=true;btn.classList.remove("ready");btn.textContent="OK (2s)";
    setTimeout(function(){
      btn.disabled=false;btn.classList.add("ready");btn.textContent="OK";
    },2000);
    btn.onclick=function(){if(btn.disabled)return;ov.classList.remove("show");};
  }

  // Custom brush 5x5 mask
  window.customBrushMask=[];
  for(var i=0;i<25;i++)window.customBrushMask[i]=1;
  var bg=document.getElementById("brush-grid");
  if(bg){
    for(var i=0;i<25;i++){
      var d=document.createElement("div");
      d.className="bc on";d.dataset.i=i;
      d.onclick=function(){
        var i=+this.dataset.i;
        window.customBrushMask[i]=window.customBrushMask[i]?0:1;
        this.classList.toggle("on",!!window.customBrushMask[i]);
      };
      bg.appendChild(d);
    }
  }
  var ucb=document.getElementById("use-custom-brush");
  if(ucb){
    ucb.checked=localStorage.getItem("use_custom_brush")==="1";
    ucb.onchange=function(){localStorage.setItem("use_custom_brush",ucb.checked?"1":"0");};
  }

  // Hook placeAt / brush to use mask when 5x5
  var _origHandleTap=window.handleTap;
  // brush placement is in handleTap loops - patch setBrush usage via should use mask in place loops
})();

// Patch brush placement: when brush=5 and custom mask on, only place selected cells
(function(){
  // wrap the brush loop concept by overriding after defs load
  var prev=setBrush;
  // already defined
})();

