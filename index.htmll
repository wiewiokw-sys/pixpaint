// Auth
var regMode=true;
window.openAuth=function(reg){
  closeOv("ov-profile");
  regMode=reg;
  document.getElementById("auth-title").textContent=reg?"Register":"Login";
  document.getElementById("auth-switch").textContent=reg?"Login instead":"Register instead";
  document.getElementById("auth-pass2").style.display=reg?"block":"none";
  document.getElementById("auth-pass2-lab").style.display=reg?"block":"none";
  document.getElementById("auth-dname").style.display=reg?"block":"none";
  var labs=document.getElementById("ov-auth").querySelectorAll("label");
  labs.forEach(function(lab){if(lab.textContent.indexOf("Display")>=0)lab.style.display=reg?"block":"none";});
  openOv("ov-auth");
};
document.getElementById("auth-switch").onclick=function(){openAuth(!regMode);};
document.getElementById("auth-go").onclick=async function(){
  var dname=document.getElementById("auth-dname").value.trim();
  var u=document.getElementById("auth-user").value.trim().replace(/^@/,"");
  var p=document.getElementById("auth-pass").value;
  var p2=document.getElementById("auth-pass2").value;
  if(!u||!p)return notify("Fill fields");
  try{
    if(regMode){
      if(p!==p2)return notify("Passwords mismatch");
      if(!dname)return notify("Enter name");
      await api("/register",{method:"POST",json:{display_name:dname,username:u,password:p}});
      var fd=new FormData();fd.append("username",u);fd.append("password",p);
      var r=await fetch("/token",{method:"POST",body:fd});var d=await r.json();
      if(!r.ok)throw new Error(d.detail||"Login failed");
      token=d.access_token;localStorage.setItem("pix_token",token);user=d.user;closeOv("ov-auth");loadMe();notify("Welcome");
    }else{
      var fd2=new FormData();fd2.append("username",u);fd2.append("password",p);
      var r2=await fetch("/token",{method:"POST",body:fd2});var d2=await r2.json();
      if(!r2.ok)throw new Error(d2.detail||"Login failed");
      token=d2.access_token;localStorage.setItem("pix_token",token);user=d2.user;closeOv("ov-auth");loadMe();notify("Welcome");
    }
  }catch(e){notify(e.message);}
};

