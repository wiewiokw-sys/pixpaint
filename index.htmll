<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>PixPaint</title>
<style>
:root{--bg:#0b0e14;--panel:#151a23;--panel2:#1c2330;--border:#2a3344;--text:#e8eef7;--muted:#8b9bb4;--accent:#3b82f6;--green:#22c55e;--danger:#ef4444;--gold:#fbbf24}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;overflow:hidden;background:var(--bg);color:var(--text);font-family:system-ui,sans-serif;user-select:none;-webkit-user-select:none}
#app{height:100vh;width:100vw;position:relative}
#canvas-wrap{position:absolute;inset:0;overflow:hidden;touch-action:none;background:#6b7280}
#bg-map,#pixel-canvas,#template-canvas,#grid-canvas,#zone-canvas{position:absolute;top:0;left:0;transform-origin:0 0;pointer-events:none;image-rendering:pixelated}
#bg-map{z-index:1}
#template-canvas{z-index:2}
#zone-canvas{z-index:3}
#pixel-canvas{z-index:4}
#grid-canvas{z-index:5}
#hud{position:absolute;top:8px;left:50%;transform:translateX(-50%);background:rgba(21,26,35,.93);border:1px solid var(--border);border-radius:999px;padding:6px 14px;display:flex;gap:12px;align-items:center;z-index:30;font-size:12px;max-width:70vw}
#coords{font-family:monospace;color:var(--muted)}
#pix-info{color:var(--green);font-weight:700}
#coin-btn{position:absolute;top:8px;right:8px;z-index:30;width:48px;height:48px;border-radius:50%;border:2px solid var(--gold);background:var(--panel);display:grid;place-items:center;cursor:pointer;overflow:hidden}
#coin-btn .fill{position:absolute;bottom:0;left:0;right:0;background:var(--gold);opacity:.45;height:0%;transition:height .3s linear}
#coin-btn.ready{animation:coinPulse 2s infinite}
#coin-btn.cd{border-color:#666;filter:grayscale(1)}
#coin-btn svg{width:26px;height:26px;position:relative;z-index:1}
@keyframes coinPulse{0%{box-shadow:0 0 8px 2px rgba(255,255,255,.9);border-color:#fff}50%{box-shadow:0 0 14px 4px rgba(251,191,36,.95);border-color:#fbbf24}100%{box-shadow:0 0 8px 2px rgba(255,255,255,.9);border-color:#fff}}
#menu-btn{position:absolute;left:8px;top:8px;z-index:30;width:40px;height:40px;border-radius:10px;border:1px solid var(--border);background:var(--panel);color:var(--text);cursor:pointer;display:grid;place-items:center}
#menu-btn svg{width:20px;height:20px;fill:currentColor}
#menu{position:absolute;left:8px;top:54px;z-index:30;background:var(--panel);border:1px solid var(--border);border-radius:12px;padding:6px;display:none;flex-direction:column;min-width:160px}
#menu.show{display:flex}
#menu button{border:none;background:transparent;color:var(--text);text-align:left;padding:10px 12px;border-radius:8px;cursor:pointer;font-size:13px;display:flex;align-items:center;gap:8px}
#menu button:hover{background:var(--panel2)}
#menu button svg{width:16px;height:16px;fill:currentColor;flex-shrink:0}
#admin-btn{position:absolute;left:8px;top:50%;transform:translateY(-50%);z-index:30;width:40px;height:40px;border-radius:10px;border:1px solid var(--danger);background:var(--panel);color:var(--danger);cursor:pointer;display:none;place-items:center}
#admin-btn svg{width:20px;height:20px;fill:currentColor}
#tools{position:absolute;right:8px;top:64px;display:flex;flex-direction:column;gap:6px;z-index:30}
.tool{width:42px;height:42px;border-radius:10px;border:1px solid var(--border);background:var(--panel);color:var(--text);font-weight:700;font-size:12px;cursor:pointer;display:grid;place-items:center}
.tool.active{border-color:var(--accent);background:var(--panel2)}
.tool.auto{border-color:var(--danger)!important;background:#3f1d1d!important}
.tool svg{width:20px;height:20px;fill:currentColor}
#mid-bar{position:absolute;left:8px;right:8px;bottom:175px;z-index:30;display:flex;align-items:center;justify-content:space-between;pointer-events:none}
#mid-bar .stat{display:flex;gap:12px;pointer-events:auto;background:rgba(21,26,35,.92);border:1px solid var(--border);border-radius:10px;padding:6px 12px;font-size:12px;align-items:center}
#mid-bar .stat span{display:flex;align-items:center;gap:4px}
#mid-bar .stat svg{width:14px;height:14px;fill:currentColor}
#mid-chat{pointer-events:auto;border:1px solid var(--border);background:rgba(21,26,35,.92);color:var(--text);border-radius:10px;padding:6px 12px;font-size:12px;cursor:pointer;display:flex;align-items:center;gap:4px}
#mid-chat svg{width:14px;height:14px;fill:currentColor}
#palette-bar{position:absolute;bottom:52px;left:50%;transform:translateX(-50%);z-index:30;display:flex;flex-direction:column;align-items:center;gap:4px;width:min(96vw,480px);transition:transform .5s ease,opacity .5s ease}
#palette-bar.hidden-pal{transform:translateX(-50%) translateY(120%);opacity:0;pointer-events:none}
#palette-nav{display:flex;gap:8px;align-items:center;justify-content:center;width:100%;position:relative}
#palette-nav button{width:32px;height:28px;border-radius:8px;border:1px solid var(--border);background:var(--panel);color:var(--text);cursor:pointer}
#btn-hide-pal{position:absolute;right:8px;bottom:8px;z-index:40;width:44px;height:44px;border-radius:12px;border:1px solid var(--border);background:var(--panel);color:var(--text);cursor:pointer;display:grid;place-items:center}
#btn-hide-pal svg{width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:1.7}
#event-overlay{position:fixed;inset:0;z-index:90;pointer-events:none;display:none}
#event-overlay.night{display:block;background:rgba(20,40,120,.9)}
#event-overlay.haos{display:block;background:rgba(180,20,20,.9)}
#event-overlay.won{display:block;background:rgba(200,170,20,.9)}
#window-sms{position:fixed;inset:0;z-index:220;background:rgba(0,0,0,.65);display:none;align-items:center;justify-content:center;padding:16px}
#window-sms .box{background:var(--panel);border:1px solid var(--border);border-radius:14px;padding:18px;max-width:360px;width:100%;text-align:center}
#window-sms .from{color:var(--muted);font-size:12px;margin-bottom:8px}
#tool-chat.has-new{animation:chatPulse 1.2s infinite;border-color:#ef4444!important}
@keyframes chatPulse{0%{box-shadow:0 0 6px 1px rgba(255,255,255,.85);border-color:#fff}50%{box-shadow:0 0 12px 3px rgba(239,68,68,.95);border-color:#ef4444}100%{box-shadow:0 0 6px 1px rgba(255,255,255,.85);border-color:#fff}}
#hud.flash-red{background:#7f1d1d!important;transition:background .15s}
#palette-wrap{width:100%;overflow:hidden;border-radius:12px;border:1px solid var(--border);background:rgba(21,26,35,.95)}
#palette{display:flex;transition:transform .28s ease;touch-action:pan-y}
.pal-page{display:grid;grid-template-columns:repeat(10,1fr);gap:4px;padding:8px;min-width:100%;flex-shrink:0}
.swatch{width:100%;aspect-ratio:1;border-radius:5px;border:2px solid transparent;cursor:pointer;min-height:26px}
.swatch.selected{border-color:#fff;box-shadow:0 0 0 1px #000}
#bottom{position:absolute;bottom:0;left:0;right:0;height:44px;background:var(--panel);border-top:1px solid var(--border);display:flex;align-items:center;gap:8px;padding:0 10px;z-index:30}
#status{margin-left:auto;font-size:11px;color:var(--muted)}
#chat{position:fixed;right:56px;bottom:100px;width:min(320px,94vw);height:min(360px,50vh);background:rgba(21,26,35,.98);border:1px solid var(--border);border-radius:12px;display:none;flex-direction:column;z-index:150;box-shadow:0 8px 30px rgba(0,0,0,.5)}
#chat.show{display:flex}
#chat-tabs{display:flex;border-bottom:1px solid var(--border)}
#chat-tabs button{flex:1;padding:8px 2px;border:none;background:transparent;color:var(--muted);cursor:pointer;font-size:11px}
#chat-tabs button.active{color:var(--text);border-bottom:2px solid var(--accent)}
#chat-msgs{flex:1;overflow-y:auto;padding:8px;font-size:12px;max-height:180px}
.msg{margin-bottom:6px;display:flex;gap:6px;align-items:flex-start}
.msg .av{width:24px;height:24px;border-radius:50%;display:grid;place-items:center;font-size:11px;font-weight:700;color:#fff;flex-shrink:0}
.msg .body{flex:1}.msg .u{font-weight:600;color:#60a5fa}.msg .u.mod{color:#f97316}
.msg .t{color:var(--muted);font-size:10px;margin-left:4px}
#chat-row{display:flex;border-top:1px solid var(--border)}
#chat-input{flex:1;border:none;background:transparent;padding:8px;color:var(--text);font-size:12px}
#chat-send,#chat-close{border:none;background:var(--accent);color:#fff;padding:0 10px;cursor:pointer;font-size:12px}
#chat-close{background:var(--panel2);border-left:1px solid var(--border);color:var(--text)}
#lookup{position:absolute;z-index:50;display:none;min-width:240px;max-width:300px;background:var(--panel);border:1px solid var(--border);border-radius:12px;padding:12px;font-size:13px;box-shadow:0 8px 30px rgba(0,0,0,.45)}
#auth-block{position:fixed;inset:0;background:rgba(0,0,0,.75);z-index:90;display:none;align-items:center;justify-content:center;font-size:22px;font-weight:700;text-align:center;padding:20px}
#auth-block.show{display:flex}
.overlay{position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:100;display:none;align-items:center;justify-content:center;padding:12px}
.overlay.show{display:flex}
.modal{background:var(--panel);border:1px solid var(--border);border-radius:14px;padding:18px;width:min(400px,96vw);max-height:88vh;overflow-y:auto}
.modal h2{font-size:16px;margin-bottom:10px}
.modal label{display:block;font-size:12px;color:var(--muted);margin:8px 0 4px}
.modal input,.modal select{width:100%;padding:10px;border-radius:8px;border:1px solid var(--border);background:#0b0e14;color:var(--text);font-size:14px}
.modal .row{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
.modal button{padding:9px 14px;border-radius:8px;border:none;background:var(--accent);color:#fff;font-weight:600;cursor:pointer;font-size:13px}
.modal button.ghost{background:var(--panel2);border:1px solid var(--border);color:var(--text)}
.modal button.danger{background:var(--danger)}
.medal-row{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0}
.medal{width:56px;text-align:center;opacity:.35}
.medal.on{opacity:1}
.medal .ico{width:40px;height:40px;border-radius:10px;background:var(--panel2);border:1px solid var(--border);display:grid;place-items:center;margin:0 auto 4px}
.medal .ico svg{width:20px;height:20px;fill:currentColor}
.medal small{font-size:10px;color:var(--muted);display:block}
#earn-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:10px 0}
.earn-opt{padding:12px 6px;border-radius:10px;border:1px solid var(--border);background:var(--panel2);text-align:center;cursor:pointer;font-size:13px;text-transform:capitalize}
#earn-q{text-align:center;font-size:28px;margin:8px 0;font-weight:700}
#notify{position:fixed;bottom:128px;left:50%;transform:translateX(-50%);background:var(--panel);border:1px solid var(--border);padding:8px 14px;border-radius:10px;z-index:200;display:none;max-width:70vw;font-size:13px;font-weight:600;box-shadow:0 8px 24px rgba(0,0,0,.4);pointer-events:none}
#notify.show{display:block}
.prof-line{display:flex;align-items:center;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--border);font-size:13px}
.prof-line button{padding:4px 10px;font-size:11px;border-radius:6px;border:1px solid var(--border);background:var(--panel2);color:var(--text);cursor:pointer}
.lb-row{display:flex;justify-content:space-between;padding:8px;border-bottom:1px solid var(--border);font-size:13px}
.lb-row .r{width:24px;color:var(--gold);font-weight:700}
#target-cross{display:none;position:absolute;left:50%;top:50%;width:14px;height:14px;margin:-7px 0 0 -7px;z-index:25;pointer-events:none;border:2px solid red;animation:tgtBlink 3s infinite}
@keyframes cloudFx{0%{transform:scale(0.4);opacity:1}100%{transform:scale(2.2);opacity:0}}
@keyframes tgtBlink{0%,90%{border-color:red}95%{border-color:#fff}}

#boot-screen{position:fixed;inset:0;z-index:9999;background:#0b0e14;display:flex;flex-direction:column;align-items:center;justify-content:center;transition:opacity .4s}
#boot-screen.hide{opacity:0;pointer-events:none}
#boot-logo{font-size:clamp(28px,8vw,52px);font-weight:900;letter-spacing:2px;margin-bottom:40px}
#boot-logo span{display:inline-block;animation:pixBounce 1.2s ease-in-out infinite}
#boot-bar-wrap{width:min(80vw,320px);height:18px;background:#1c2330;border-radius:6px;overflow:hidden;border:1px solid #2a3344;display:flex}
#boot-bar-wrap .cube{flex:1;height:100%;opacity:0;transition:opacity .15s}
@keyframes pixBounce{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
#rules-ov{position:fixed;inset:0;z-index:500;background:rgba(0,0,0,.75);display:none;align-items:center;justify-content:center;padding:16px}
#rules-ov.show{display:flex}
#rules-ov .box{background:var(--panel);border:1px solid var(--border);border-radius:14px;padding:18px;max-width:400px;width:100%}
#rules-ov h2{margin-bottom:10px}
#rules-ov li{font-size:13px;margin:4px 0;color:var(--text)}
#rules-ok{margin-top:14px;width:100%;padding:12px;border:none;border-radius:10px;background:var(--accent);color:#fff;font-weight:700;cursor:pointer;opacity:.4}
#rules-ok.ready{opacity:1}
#event-overlay{z-index:8!important;pointer-events:none}
#event-overlay.blue{display:block;background:rgba(30,80,220,var(--ev-op,.8))}
#event-overlay.yellow{display:block;background:rgba(220,180,20,var(--ev-op,.8))}
#event-overlay.red{display:block;background:rgba(200,30,30,var(--ev-op,.8))}
#event-overlay.green{display:block;background:rgba(30,160,60,var(--ev-op,.8))}
#event-overlay.select{display:block;background:rgba(10,20,60,.92)}
#build-bar{z-index:25!important}
#menu{z-index:40!important}
#select-panel{position:fixed;inset:0;z-index:400;display:none;align-items:center;justify-content:center;flex-direction:column;gap:16px;background:rgba(5,10,40,0);transition:background 2s}
#select-panel.show{display:flex;background:rgba(5,10,40,.92)}
#select-panel .title{font-size:22px;font-weight:800;color:#fff;margin-bottom:8px}
#select-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
#select-grid button{width:90px;height:90px;border-radius:16px;border:3px solid #fff;font-size:28px;font-weight:900;color:#fff;cursor:pointer;animation:selBlink 1s infinite;opacity:.5;pointer-events:none}
#select-grid button.go{opacity:1;pointer-events:auto}
@keyframes selBlink{0%,100%{filter:brightness(1)}50%{filter:brightness(1.4)}}
#select-timer{color:#fff;font-size:14px}
#clan-boost-btn{position:fixed;right:16px;bottom:200px;z-index:35;width:52px;height:52px;border-radius:50%;border:2px solid var(--gold);background:var(--panel);display:none;place-items:center;cursor:grab;touch-action:none}
#clan-boost-btn svg{width:26px;height:26px;fill:var(--gold)}
#boost-banner{position:fixed;top:56px;left:50%;transform:translateX(-50%);z-index:180;background:rgba(21,26,35,.95);border:1px solid var(--gold);border-radius:10px;padding:8px 14px;font-size:13px;display:none}
#video-mode-x{position:fixed;right:20px;top:20px;z-index:600;width:48px;height:48px;border-radius:50%;border:2px solid #fff;background:rgba(0,0,0,.5);color:#fff;font-size:24px;display:none;place-items:center;cursor:grab;touch-action:none}
body.video-mode #menu-btn,body.video-mode #menu,body.video-mode #tools,body.video-mode #palette-bar,body.video-mode #bottom,body.video-mode #mid-bar,body.video-mode #coin-btn,body.video-mode #btn-hide-pal,body.video-mode #hud,body.video-mode #admin-btn{display:none!important}
body.video-mode #video-mode-x{display:grid}
#coin-btn.mode-animal .fill{background:#22c55e!important}
#coin-btn.mode-animal.ready{animation:coinPulseGreen 1.2s infinite}
#coin-btn.mode-math .fill{background:#7f1d1d!important}
#coin-btn.mode-math.ready{animation:coinPulseRed 1.2s infinite}
#coin-btn.mode-color .fill{background:#9d174d!important}
#coin-btn.mode-color.ready{animation:coinPulsePink 1.2s infinite}
@keyframes coinPulseGreen{0%,100%{box-shadow:0 0 8px 2px rgba(34,197,94,.7)}50%{box-shadow:0 0 16px 4px rgba(74,222,128,.95)}}
@keyframes coinPulseRed{0%,100%{box-shadow:0 0 8px 2px rgba(127,29,29,.7)}50%{box-shadow:0 0 16px 4px rgba(239,68,68,.95)}}
@keyframes coinPulsePink{0%,100%{box-shadow:0 0 8px 2px rgba(157,23,77,.7)}50%{box-shadow:0 0 16px 4px rgba(244,114,182,.95)}}
.brush-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:4px;width:160px;margin:8px 0}
.brush-grid .bc{aspect-ratio:1;border-radius:4px;border:2px solid var(--border);background:var(--panel2);cursor:pointer}
.brush-grid .bc.on{background:var(--accent);border-color:#fff}

</style>
</head>
<body>

<div id="boot-screen">
  <div id="boot-logo"></div>
  <div id="boot-bar-wrap"></div>
</div>
<div id="rules-ov"><div class="box">
  <h2>Rules / Правила</h2>
  <ol style="padding-left:18px">
    <li>1.1 Doting — 50m</li>
    <li>1.2 Wave Attack — 200m</li>
    <li>1.3 Obscene symbols (Nazism, penis art 18+) — 200m</li>
    <li>2.1 Politic discussion — 100m</li>
    <li>2.2 Spam — 2m / 30m</li>
    <li>2.3 ADS — 40m</li>
  </ol>
  <button id="rules-ok" disabled>OK (2s)</button>
</div></div>
<div id="select-panel">
  <div class="title" id="select-title">ВЫБЕРИТЕ</div>
  <div id="select-grid">
    <button data-c="1" style="background:#ef4444">1</button>
    <button data-c="2" style="background:#3b82f6">2</button>
    <button data-c="3" style="background:#eab308">3</button>
    <button data-c="4" style="background:#22c55e">4</button>
  </div>
  <div id="select-timer">10</div>
</div>
<button id="clan-boost-btn" title="Clan boost"><svg viewBox="0 0 24 24"><path d="M6.5 19L12 4l5.5 15H15l-1.2-3.5h-3.6L9 19H6.5zM11.1 13h1.8L12 9.8 11.1 13zM4 21h16v2H4z"/></svg></button>
<div id="boost-banner"></div>
<div id="video-mode-x">✕</div>

<div id="app">
<div id="canvas-wrap">
<img id="bg-map" src="world_map.png" draggable="false" style="width:4096px;height:4096px;object-fit:fill">
<canvas id="template-canvas" width="4096" height="4096"></canvas>
<canvas id="zone-canvas" width="4096" height="4096"></canvas>
<canvas id="pixel-canvas" width="4096" height="4096"></canvas>
<canvas id="grid-canvas" width="4096" height="4096"></canvas>
<canvas id="glow-canvas" style="position:absolute;inset:0;z-index:6;pointer-events:none"></canvas>
<canvas id="grid-overlay" style="position:absolute;inset:0;z-index:5;pointer-events:none;display:none"></canvas></div>
<button id="menu-btn"><svg viewBox="0 0 24 24"><path d="M3 6h18v2H3V6zm0 5h18v2H3v-2zm0 5h18v2H3v-2z"/></svg></button>
<div id="menu">
<button id="btn-template" style="display:none">Templates</button>

<button id="btn-news"><svg viewBox="0 0 24 24"><path d="M4 6h12v12H4V6zm14 0h2v12h-2V6zM6 8h8v2H6V8zm0 3h8v2H6v-2zm0 3h5v2H6v-2z"/></svg>News <span id="news-dot" style="display:none;width:8px;height:8px;background:#ef4444;border-radius:50%;margin-left:6px"></span></button>
<button id="btn-profile"><svg viewBox="0 0 24 24"><path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/></svg>Profile</button>
<button id="btn-settings"><svg viewBox="0 0 24 24"><path d="M19.1 12.9c.1-.3.1-.6.1-.9s0-.6-.1-.9l2.1-1.6c.2-.1.2-.4.1-.6l-2-3.5c-.1-.2-.4-.3-.6-.2l-2.5 1c-.5-.4-1.1-.7-1.7-.9l-.4-2.6c0-.2-.2-.4-.5-.4h-4c-.2 0-.5.2-.5.4l-.4 2.6c-.6.2-1.2.5-1.7.9l-2.5-1c-.2-.1-.5 0-.6.2l-2 3.5c-.1.2 0 .5.2.6l2.1 1.6c-.1.3-.1.6-.1.9s0 .6.1.9L2.8 14.5c-.2.1-.2.4-.1.6l2 3.5c.1.2.4.3.6.2l2.5-1c.5.4 1.1.7 1.7.9l.4 2.6c0 .2.2.4.5.4h4c.2 0 .5-.2.5-.4l.4-2.6c.6-.2 1.2-.5 1.7-.9l2.5 1c.2.1.5 0 .6-.2l2-3.5c.1-.2 0-.5-.1-.6l-2.2-1.6zM12 15.5c-1.9 0-3.5-1.6-3.5-3.5s1.6-3.5 3.5-3.5 3.5 1.6 3.5 3.5-1.6 3.5-3.5 3.5z"/></svg>Settings</button>
<button id="btn-records"><svg viewBox="0 0 24 24"><path d="M8 21h8v-1H8v1zm4-18a5 5 0 00-5 5c0 1.8.9 3.4 2.3 4.3L8 17h8l-1.3-4.7A5 5 0 0017 8a5 5 0 00-5-5zm0 2a3 3 0 110 6 3 3 0 010-6zM6.5 19h11v-1.5h-11V19z"/></svg>Records</button>
<button id="btn-clans"><svg viewBox="0 0 24 24"><path d="M16 11c1.7 0 3-1.3 3-3s-1.3-3-3-3-3 1.3-3 3 1.3 3 3 3zM8 11c1.7 0 3-1.3 3-3S9.7 5 8 5 5 6.3 5 8s1.3 3 3 3zm0 2c-2.3 0-7 1.2-7 3.5V19h14v-2.5C15 14.2 10.3 13 8 13zm8 0c-.3 0-.6 0-1 .1 1.2.9 2 2.1 2 3.4V19h6v-2.5c0-2.3-4.7-3.5-7-3.5z"/></svg>Clans</button>
<button id="btn-videos"><svg viewBox="0 0 24 24"><path d="M18 4v1h-2V4H8v1H6V4H4v16h2v-1h2v1h8v-1h2v1h2V4h-2zM8 17H6v-2h2v2zm0-4H6v-2h2v2zm0-4H6V7h2v2zm10 8h-2v-2h2v2zm0-4h-2v-2h2v2zm0-4h-2V7h2v2z"/></svg>Videos <span id="videos-dot" style="display:none;width:8px;height:8px;background:#ef4444;border-radius:50%;margin-left:4px"></span></button>
<button id="btn-questions"><svg viewBox="0 0 24 24"><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm1 17h-2v-2h2v2zm1.1-7.5l-.9.9c-.7.7-1.1 1.3-1.1 2.6h-2v-.5c0-1.1.4-2.1 1.2-2.8l1.2-1.3c.4-.3.6-.8.6-1.4 0-1.1-.9-2-2-2s-2 .9-2 2H8c0-2.2 1.8-4 4-4s4 1.8 4 4c0 .9-.4 1.7-.9 2.3z"/></svg>Questions <span id="q-dot" style="display:none;width:8px;height:8px;background:#ef4444;border-radius:50%;margin-left:4px"></span></button>
<button id="btn-report"><svg viewBox="0 0 24 24"><path d="M12 2L1 21h22L12 2zm0 3.5L19.5 19h-15L12 5.5zM11 10v4h2v-4h-2zm0 6v2h2v-2h-2z"/></svg>Report</button>

<button id="btn-tem-dl"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M12 7v8M9 12l3 3 3-3"/></svg>Tem.Download</button>
<button id="btn-download"><svg viewBox="0 0 24 24"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>Screenshot</button>
</div>
<button id="admin-btn"><svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.5 3.8 10.7 9 12 5.2-1.3 9-6.5 9-12V5l-9-4z"/></svg></button>
<button id="coin-btn"><div class="fill" id="coin-fill"></div><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" fill="#fbbf24"/><text x="12" y="16" text-anchor="middle" font-size="11" font-weight="bold" fill="#78350f">$</text></svg></button>
<div id="hud"><span id="coords">0000 x 0000</span><span id="ping" style="font-family:monospace;color:var(--muted)">— ms</span><span>Pixels: <span id="pix-info">0/0</span></span></div>
<div id="tools">
<button class="tool active" id="tool-paint" title="Brush"><svg viewBox="0 0 24 24"><path d="M7 14c-1.7 0-3 1.3-3 3 0 1.3-1 2-2 2 .8 1.3 2.5 2 4 2 2.2 0 4-1.8 4-4 0-1.7-1.3-3-3-3zm13.7-9.3c.4-.4.4-1 0-1.4l-2-2c-.4-.4-1-.4-1.4 0L9 11.6 7.4 10 6 11.4l2.8 2.8L3 20h3l7.8-7.8 2.8 2.8 1.4-1.4-1.6-1.6L20.7 4.7z"/></svg></button>
<button class="tool" id="tool-chat" title="Chat"><svg viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/></svg></button>
<button class="tool" id="tool-pipette" title="Eyedropper"><svg viewBox="0 0 24 24"><path d="M20.71 5.63l-2.34-2.34a1 1 0 00-1.41 0l-3.12 3.12-1.23-1.21 1.41-1.42-1.42-1.41-8.8 8.79a3 3 0 00-.72 1.25L2 19.75 4.25 19l1.08-1.08a3 3 0 001.25-.72l8.79-8.8-1.41-1.41-1.42 1.41 1.21 1.23 3.12-3.12a1 1 0 000-1.41zM7.42 15.17L5.5 17.1l-.6-.6 1.92-1.93.6.6zm2.12-2.12l-1.93 1.93-.6-.6 1.93-1.93.6.6z"/></svg></button>
<button class="tool" id="brush-cycle">1</button>
<button class="tool" id="tool-terrain" title="Terrain filter">
<svg id="terrain-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
  <path d="M8 8l4-5 4 5v3H8V8z"/><path d="M4 20l8-12 8 12"/><path d="M16 14c0 0 1.2 2.5 2.5 3.2"/><path d="M18.2 17.5c.4.5.6 1 .6 1.5 0 .8-.6 1.5-1.4 1.5S16 19.8 16 19"/>
</svg>
</button>
<button class="tool" id="tool-radar" title="Radar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
  <circle cx="12" cy="12" r="8"/>
  <rect x="9.2" y="9.2" width="5.6" height="5.6" fill="currentColor" stroke="none"/>
  <path d="M12 2v2.2M12 19.8V22M2 12h2.2M19.8 12H22M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M4.9 19.1l1.6-1.6M17.5 6.5l1.6-1.6"/>
</svg></button>
<button class="tool" id="tool-pencil" title="Pencil"><svg viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg></button>
</div>
<div id="mid-bar">
<div class="stat">
<span id="btn-online" style="cursor:pointer" title="Online list"><svg viewBox="0 0 24 24"><path d="M12 12c2.2 0 4-1.8 4-4s-1.8-4-4-4-4 1.8-4 4 1.8 4 4 4zm0 2c-2.7 0-8 1.3-8 4v2h16v-2c0-2.7-5.3-4-8-4z"/></svg><b id="mid-on">0</b></span>
<span><svg viewBox="0 0 24 24"><path d="M3 3h6v6H3V3zm8 0h6v6h-6V3zM3 13h6v6H3v-6zm8 0h6v6h-6v-6z"/><path d="M5 5h2v2H5V5zm8 0h2v2h-2V5zM5 15h2v2H5v-2zm8 0h2v2h-2v-2z" fill="#0b0e14"/></svg><b id="mid-px">0</b></span>
</div>

</div>
<div id="palette-bar">
<div id="palette-nav">
<button id="pal-prev">‹</button>
<span id="pal-cost" style="display:none;background:rgba(15,20,30,.95);border:1px solid #7f1d1d;border-radius:8px;padding:4px 10px;color:#ef4444;font-weight:700;font-size:13px;white-space:nowrap;min-width:52px;text-align:center">-0/0</span>
<span id="palette-page" style="color:var(--muted);font-size:12px">1/1</span>
<button id="pal-next">›</button>
</div>
<div id="palette-wrap"><div id="palette"></div></div>
</div>
<div id="bottom"><span id="status">...</span></div>
<button id="btn-hide-pal" title="Palette">
<svg viewBox="0 0 24 24"><path d="M12 3c-4.5 0-8 3.2-8 7.2 0 2.6 1.5 4.8 3.7 6-.2 1.2-.8 2.3-1.7 3.1 2.2-.3 4.1-1.4 5.2-2.9.3 0 .5.1.8.1 4.5 0 8-3.2 8-7.2S16.5 3 12 3z"/><circle cx="8.5" cy="9.5" r="1.1" fill="currentColor" stroke="none"/><circle cx="12" cy="7.8" r="1.1" fill="currentColor" stroke="none"/><circle cx="15.5" cy="9.5" r="1.1" fill="currentColor" stroke="none"/><circle cx="13.5" cy="12.5" r="1.1" fill="currentColor" stroke="none"/></svg>
</button>
<div id="event-overlay"></div>
<div id="window-sms"><div class="box"><div class="from" id="wsms-from"></div><div id="wsms-text" style="margin:12px 0;font-size:15px;line-height:1.4"></div><button id="wsms-ok" style="margin-top:8px">OK</button></div></div>
<div id="chat">
<div style="display:flex;align-items:center;justify-content:space-between;gap:6px">
<div id="chat-tabs" data-clan="1" style="flex:1">
<button class="active" data-ch="en">EN</button><button data-ch="ru">RU</button>
<button data-ch="clan" id="clan-chat-tab" style="display:none">CLAN</button></div>
<button id="chat-help" title="Mod commands" style="display:none;width:32px;height:28px;border-radius:8px;border:1px solid var(--border);background:var(--panel2);color:var(--text);cursor:pointer">🔍</button>
</div>
<div id="chat-msgs"></div>
<div id="chat-row"><input id="chat-input" maxlength="200" placeholder="Message..."><button id="chat-send">OK</button><button id="chat-close">X</button></div>
</div>
<div id="target-cross"></div>
<div id="lookup"></div>
<div id="auth-block">YOU ARE NOT AUTHORIZED<br><small style="font-size:14px;font-weight:400;opacity:.8">Open Profile to register / login</small></div>
</div>
<div id="build-bar" style="display:none;position:fixed;top:56px;left:50%;transform:translateX(-50%);z-index:160;flex-direction:column;align-items:center;gap:6px;pointer-events:auto">
<div style="display:flex;align-items:center;gap:8px;background:rgba(15,20,30,.96);border:1px solid #334155;border-radius:12px;padding:8px 10px">
  <div style="font-size:12px;line-height:1.45;color:#e8eef7">
    <div>placed : <b id="build-placed" style="color:#fbbf24">0</b></div>
    <div>have : <b id="build-have" style="color:#4ade80">0</b></div>
  </div>
  <div style="display:flex;flex-direction:column;gap:2px;align-items:center">
    <label style="font-size:10px;color:#94a3b8">за раз</label>
    <input id="build-rate" type="number" min="1" max="500" value="10" style="width:56px;padding:6px 4px;border-radius:8px;border:1px solid #475569;background:#0b0e14;color:#fff;font-size:14px;font-weight:700;text-align:center">
  </div>
  <button id="build-ok" type="button" style="width:42px;height:42px;border:none;border-radius:8px;background:#16a34a;color:#fff;font-size:20px;cursor:pointer">✓</button>
  <button id="build-cancel" type="button" style="width:42px;height:42px;border:none;border-radius:8px;background:#991b1b;color:#fff;font-size:20px;cursor:pointer">✕</button>
</div>
</div>
<div id="build-cost-bottom" style="display:none!important;position:fixed;bottom:118px;right:12px;z-index:95;background:rgba(15,20,30,.9);border:1px solid #7f1d1d;border-radius:8px;padding:6px 10px;color:#ef4444;font-weight:700;font-size:14px">-0/0</div>
<div id="notify"></div>

<div class="overlay" id="ov-auth"><div class="modal">
<h2 id="auth-title">Register</h2>
<label>Display name</label><input id="auth-dname" placeholder="Name">
<label>Username (@)</label><input id="auth-user" placeholder="user">
<label>Password</label><input id="auth-pass" type="password">
<label id="auth-pass2-lab">Password again</label><input id="auth-pass2" type="password">
<div class="row"><button id="auth-go">OK</button><button class="ghost" id="auth-switch">Login instead</button><button class="ghost" onclick="closeOv('ov-auth')">Close</button></div>
</div></div>

<div class="overlay" id="ov-profile"><div class="modal">
<h2>Profile</h2>
<div id="profile-body"></div>
<div class="medal-row" id="medals"></div>
<div id="rank-info" style="font-size:12px;margin:8px 0;color:var(--muted)"></div>
<label>Avatar color (0-9)</label><input id="av-color" type="number" min="0" max="9" value="0">
<div class="row"><button id="btn-av">Save avatar</button><button class="ghost" onclick="closeOv('ov-profile')">Close</button><button id="btn-logout" class="danger" style="display:none">Logout</button></div>
</div></div>

<div class="overlay" id="ov-news"><div class="modal" style="max-width:440px">
<h2>News</h2>
<div id="news-mod" style="display:none;margin-bottom:10px">
<input id="news-title" placeholder="Title" style="width:100%;margin-bottom:6px">
<textarea id="news-body" placeholder="Text..." rows="3" style="width:100%;margin-bottom:6px;background:#0b0e14;color:var(--text);border:1px solid var(--border);border-radius:8px;padding:8px"></textarea>
<input id="news-img" placeholder="Image URL (optional)" style="width:100%;margin-bottom:6px">
<button id="news-post">Publish</button>
</div>
<div id="news-list" style="max-height:55vh;overflow-y:auto"></div>
<div class="row"><button class="ghost" onclick="closeOv('ov-news')">Exit</button></div>
</div></div>
<div class="overlay" id="ov-mod-recent"><div class="modal">
<h2>Recent users</h2>
<div id="mod-recent-list" style="max-height:60vh;overflow-y:auto;font-size:13px"></div>
<div class="row"><button class="ghost" onclick="closeOv('ov-mod-recent')">Close</button></div>
</div></div>
<div class="overlay" id="ov-settings"><div class="modal">
<h2>Settings</h2>
<label>Language</label>
<select id="lang"><option value="en">English</option><option value="ru">Русский</option><option value="uk">Українська</option><option value="tr">Türkçe</option></select>
<label style="margin-top:12px;display:flex;align-items:center;justify-content:space-between">Pixel grid <input type="checkbox" id="tog-grid"></label>
<label style="margin-top:8px;display:flex;align-items:center;justify-content:space-between">Target mode <input type="checkbox" id="tog-target"></label>
<label style="margin-top:8px;display:flex;align-items:center;justify-content:space-between">Enemy smoke glow (others) <input type="checkbox" id="tog-fx" checked></label>
<hr style="border-color:var(--border);margin:12px 0">
<div style="font-size:13px;font-weight:600;margin-bottom:6px">Build mode (phantoms) for:</div>
<label style="display:flex;align-items:center;justify-content:space-between;margin-top:4px">Pencil <input type="checkbox" id="bm-pencil"></label>
<label style="display:flex;align-items:center;justify-content:space-between;margin-top:4px">3×3 <input type="checkbox" id="bm-3"></label>
<label style="display:flex;align-items:center;justify-content:space-between;margin-top:4px">5×5 <input type="checkbox" id="bm-5"></label>
<label style="display:flex;align-items:center;justify-content:space-between;margin-top:4px">Pencil + 3×3 <input type="checkbox" id="bm-p3"></label>
<label style="display:flex;align-items:center;justify-content:space-between;margin-top:4px">Pencil + 5×5 <input type="checkbox" id="bm-p5"></label>
<hr style="border-color:var(--border);margin:12px 0">
<div class="row"><button id="btn-hints" class="ghost">Hints (keyboard)</button><button id="btn-device" class="ghost">Device</button></div>
<label style="margin-top:12px">Mod code</label><input id="mod-code" placeholder="Enter code">
<div class="row"><button id="btn-mod">Become moderator</button><button class="ghost" onclick="closeOv('ov-settings')">Close</button></div>
<hr style="border-color:var(--border);margin:12px 0">
<button id="btn-video-mode" class="ghost" style="width:100%;margin-bottom:8px">VIDEO MODE</button>
<div style="font-size:13px;font-weight:600;margin:8px 0">Custom brush (5×5)</div>
<div class="brush-grid" id="brush-grid"></div>
<label style="display:flex;align-items:center;gap:8px;margin:6px 0"><input type="checkbox" id="use-custom-brush"> Use custom brush</label>
<button id="btn-open-templates" class="ghost" style="width:100%;margin-top:10px">Templates</button>
</div></div>

<div class="overlay" id="ov-device"><div class="modal">
<h2>Device</h2>
<p style="font-size:14px;margin-bottom:12px">На якому пристрої відкрито сайт?</p>
<div class="row">
<button id="dev-phone">📱 Телефон</button>
<button id="dev-pc">💻 Комп'ютер</button>
</div>
</div></div>

<div class="overlay" id="ov-keys"><div class="modal" style="max-width:440px">
<h2>Керування (PC)</h2>
<pre id="keys-help" style="font-size:12px;line-height:1.55;white-space:pre-wrap;background:#0b0e14;padding:12px;border-radius:8px;border:1px solid var(--border);max-height:50vh;overflow:auto"></pre>
<div class="row">
<button id="keys-change" class="ghost">Поміняти пристрій</button>
<button id="keys-ok">Продовжити</button>
</div>
</div></div>

<div class="overlay" id="ov-records"><div class="modal">
<h2>Records</h2>
<div class="row"><button id="lb-daily">Daily</button><button id="lb-all" class="ghost">All time</button></div>
<div id="lb-body" style="margin-top:10px"></div>
<button class="ghost" onclick="closeOv('ov-records')" style="margin-top:10px">Close</button>
</div></div>

<div class="overlay" id="ov-earn"><div class="modal">
<h2>Earn pixels</h2>
<div id="earn-q">?</div>
<p style="color:var(--muted);font-size:13px;text-align:center" id="earn-hint">Choose</p>
<div id="earn-grid"></div>
<p id="earn-msg" style="min-height:18px;font-size:13px;text-align:center"></p>
<button class="ghost" onclick="closeOv('ov-earn')">Close</button>
</div></div>

<div class="overlay" id="ov-clans"><div class="modal">
<h2>Clans</h2>
<label>Search @tag</label><input id="clan-search-tag">
<div class="row"><button id="btn-clan-search">Search</button></div>
<div id="clans-body" style="margin-top:10px"></div>
<hr style="border-color:var(--border);margin:12px 0">
<label>Create name</label><input id="clan-name">
<label>Create @tag</label><input id="clan-tag">
<div class="row"><button id="btn-clan-create">Create</button><button class="ghost" onclick="closeOv('ov-clans')">Close</button></div>
</div></div>

<div class="overlay" id="ov-template"><div class="modal">
<h2>Templates (max 1)</h2>
<div id="tpl-list"></div>
<input type="file" id="tpl-file" accept="image/*">
<label>Label (max 10)</label><input id="tpl-label" maxlength="10" placeholder="name">
<label>X</label><input id="tpl-x" type="number" value="0">
<label>Y</label><input id="tpl-y" type="number" value="0">
<label>Width (0=original)</label><input id="tpl-w" type="number" value="0">
<label>Opacity</label><input id="tpl-opacity" type="range" min="10" max="90" value="45">
<div class="row"><button id="btn-tpl-apply">Add</button><button class="danger" id="btn-tpl-clear">Clear all</button><button class="ghost" onclick="closeOv('ov-template')">Close</button></div>
</div></div>

<div class="overlay" id="ov-admin"><div class="modal">
<h2>Admin</h2>
<label>Target @username</label><input id="adm-target">
<label>Minutes</label><input id="adm-min" type="number" value="60">
<label>Reason</label><input id="adm-reason">
<div class="row">
<button class="danger" id="adm-ban">Ban</button>
<button id="adm-unban">Unban</button>
<button class="danger" id="adm-restrict">No place</button>
<button id="adm-allow">Allow place</button>
<button id="adm-mute">Mute</button>
<button id="adm-discord">Discord medal</button>
</div>
<hr style="border-color:var(--border);margin:12px 0">
<label>Clear X1 Y1 X2 Y2</label>
<div style="display:grid;grid-template-columns:1fr 1fr;gap:6px">
<input id="cx1" type="number" value="0"><input id="cy1" type="number" value="0">
<input id="cx2" type="number" value="100"><input id="cy2" type="number" value="100">
</div>
<label>Only color (optional)</label><input id="ccolor" placeholder="#ff0000">
<div class="row">
<button class="danger" id="adm-clear-area">Clear area</button>
<button class="danger" id="adm-clear-full">Clear ALL</button>
</div>
<hr style="border-color:var(--border);margin:12px 0">
<label>Replace from</label><input id="rep-from" placeholder="#ffffff">
<label>Replace to</label><input id="rep-to" placeholder="#000000">
<div class="row"><button class="danger" id="adm-recolor">Replace all</button></div>
<hr style="border-color:var(--border);margin:12px 0">
<label>Protect zone (use coords above)</label>
<label>Minutes (0 = forever)</label><input id="prot-min" type="number" value="30">
<div class="row">
<button id="adm-protect">Protect territory</button>
<button id="adm-protect-forever" style="background:#0e7490">Protect FOREVER</button>
</div>
<div class="row"><button class="danger" id="adm-zones-clear">Delete ALL private zones</button></div>
<hr style="border-color:var(--border);margin:12px 0">
<div class="row">
<label>Grant YouTube medal (@user)</label><input id="yt-user" placeholder="username">
<div class="row"><button id="adm-yt">Grant YouTube +15k</button><button class="ghost" id="adm-yt-off">Revoke YT</button></div>
<button id="adm-god">God mode</button>
<button class="danger" id="adm-leave">Leave mod</button>
</div>
<hr style="border-color:var(--border);margin:12px 0">
<div class="row">
<button class="danger" id="adm-wipe">DELETE ALL ACCOUNT INFO</button>
<button class="danger" id="adm-tpl-clear-all">Delete ALL public templates</button>
</div>
<div class="row"><button class="ghost" onclick="closeOv('ov-admin')">Close</button></div>
</div></div>

<div class="overlay" id="ov-temdl"><div class="modal" style="max-width:420px">
<h2>Tem.Download</h2>
<div style="display:flex;gap:6px;margin-bottom:8px">
<button id="temdl-tab-pub" class="ghost">Public</button>
<button id="temdl-tab-mine" class="ghost">Installed</button>
</div>
<div id="temdl-body" style="max-height:50vh;overflow-y:auto"></div>
<div class="row"><button class="ghost" onclick="closeOv('ov-temdl')">Close</button></div>
</div></div>
<div class="overlay" id="ov-online"><div class="modal">
<h2>Online</h2>
<div id="online-body" style="max-height:50vh;overflow-y:auto"></div>
<div class="row"><button class="ghost" onclick="closeOv('ov-online')">Close</button></div>
</div></div>
<div class="overlay" id="ov-shot"><div class="modal">
<h2>Screenshot</h2>
<p style="font-size:13px;color:var(--muted);margin-bottom:12px">Create folder <b>PixPaint</b> on your device. Screenshot of current view will download.</p>
<div class="row"><button id="btn-do-shot">Download</button><button class="ghost" onclick="closeOv('ov-shot')">Cancel</button></div>
</div></div>

<script>
(function(){
function onEl(id,fn){var el=document.getElementById(id);if(el)el.onclick=fn;return el;}

var I18N={
en:{profile:"Profile",settings:"Settings",records:"Records",templates:"Templates",clans:"Clans",screenshot:"Screenshot",chat:"Chat",login:"Login",register:"Register",logout:"Logout",close:"Close",language:"Language",grid:"Pixel grid",target:"Target mode",modcode:"Mod code",becomemod:"Become moderator",online:"online",pixels:"px",save:"Save",name:"Name",password:"Password",change:"Change",welcome:"Welcome",notlogged:"Not logged in",pencilon:"Pencil ON",penciloff:"Pencil OFF",landon:"Land-only ON",landoff:"Land-only OFF",tempon:"Template ON",tempoff:"Template OFF",temdl:"Tem.Download",draft:"Draft",confirm:"Confirm",cancel:"Cancel"},
ru:{profile:"Профиль",settings:"Настройки",records:"Рекорды",templates:"Шаблоны",clans:"Кланы",screenshot:"Скриншот",chat:"Чат",login:"Войти",register:"Регистрация",logout:"Выйти",close:"Закрыть",language:"Язык",grid:"Сетка",target:"Режим цели",modcode:"Код модератора",becomemod:"Стать модератором",online:"онлайн",pixels:"пкс",save:"Сохранить",name:"Имя",password:"Пароль",change:"Изменить",welcome:"Добро пожаловать",notlogged:"Не вошли",pencilon:"Карандаш ВКЛ",penciloff:"Карандаш ВЫКЛ",landon:"Только суша ВКЛ",landoff:"Только суша ВЫКЛ",tempon:"Шаблон ВКЛ",tempoff:"Шаблон ВЫКЛ",temdl:"Tem.Download",draft:"Черновик",confirm:"Подтвердить",cancel:"Отмена"},
uk:{profile:"Профіль",settings:"Налаштування",records:"Рекорди",templates:"Шаблони",clans:"Клани",screenshot:"Скріншот",chat:"Чат",login:"Увійти",register:"Реєстрація",logout:"Вийти",close:"Закрити",language:"Мова",grid:"Сітка",target:"Режим цілі",modcode:"Код модератора",becomemod:"Стати модератором",online:"онлайн",pixels:"пкс",save:"Зберегти",name:"Ім'я",password:"Пароль",change:"Змінити",welcome:"Вітаємо",notlogged:"Не увійшли",pencilon:"Олівець УВІМК",penciloff:"Олівець ВИМК",landon:"Лише суша УВІМК",landoff:"Лише суша ВИМК",tempon:"Шаблон УВІМК",tempoff:"Шаблон ВИМК",temdl:"Tem.Download",draft:"Чернетка",confirm:"Підтвердити",cancel:"Скасувати"},
tr:{profile:"Profil",settings:"Ayarlar",records:"Rekorlar",templates:"Şablonlar",clans:"Klanlar",screenshot:"Ekran görüntüsü",chat:"Sohbet",login:"Giriş",register:"Kayıt",logout:"Çıkış",close:"Kapat",language:"Dil",grid:"Izgara",target:"Hedef modu",modcode:"Mod kodu",becomemod:"Moderatör ol",online:"çevrimiçi",pixels:"px",save:"Kaydet",name:"İsim",password:"Şifre",change:"Değiştir",welcome:"Hoş geldin",notlogged:"Giriş yok",pencilon:"Kalem AÇIK",penciloff:"Kalem KAPALI",landon:"Sadece kara AÇIK",landoff:"Sadece kara KAPALI",tempon:"Şablon AÇIK",tempoff:"Şablon KAPALI"}
};
var curLang=localStorage.getItem("pix_lang")||"en";
function t(k){return(I18N[curLang]&&I18N[curLang][k])||(I18N.en[k])||k;}
function applyI18n(){
  var map=[["btn-profile",t("profile")],["btn-settings",t("settings")],["btn-records",t("records")],["btn-template",t("templates")],["btn-clans",t("clans")],["btn-tem-dl",t("temdl")],["btn-download",t("screenshot")]];
  map.forEach(function(m){var el=document.getElementById(m[0]);if(el){var svg=el.querySelector("svg");el.innerHTML="";if(svg)el.appendChild(svg);el.appendChild(document.createTextNode(" "+m[1]));}});
  var mc=document.getElementById("mid-chat");if(mc){var s=mc.querySelector("svg");mc.innerHTML="";if(s)mc.appendChild(s);mc.appendChild(document.createTextNode(" "+t("chat")));}
  var lo=document.getElementById("btn-logout");if(lo)lo.textContent=t("logout");
  var bm=document.getElementById("btn-mod");if(bm)bm.textContent=t("becomemod");
}

const SIZE=4096;
var WATER="#50a3d7";
// PixMap / PixelPlanet style palette
var ALL=[
"#000000","#ffffff","#e4e4e4","#c4c4c4","#888888","#4e4e4e",
"#9a0000","#e50000","#ff6565","#f4b3ae","#ffa7d1","#ff54b2",
"#9a0000","#e50000","#ff6565","#fea460","#e59500","#a06a42","#604028",
"#f5dfb0","#fff889","#e5d900","#94e044","#02be01","#688338","#006513",
"#cae3ff","#00d3dd","#0083c7","#0000ea","#191973",
"#cf6ee4","#820080","#532744","#7d2e4e","#c13747","#d67137","#fc9a29",
"#442139","#833321","#a33d18","#df6016",
"#1f257f","#0a4faf","#0a7ee6","#58edf0",
"#251433","#352143","#421564","#4a1b90","#6e4bed",
"#103a2f","#104a1f","#108e2f","#10b42f","#75d757",
WATER,
"#3989c7","#ffca00","#ff2323"
];
// unique keep order
var _seen={},_u=[];ALL.forEach(function(c){c=c.toLowerCase();if(!_seen[c]){_seen[c]=1;_u.push(c);}});ALL=_u;
var customColors=[];
var PAGE=30,PAGES=[];
for(var i=0;i<ALL.length;i+=PAGE)PAGES.push(ALL.slice(i,i+PAGE));
if(PAGES[PAGES.length-1].indexOf(WATER)<0)PAGES[PAGES.length-1].push(WATER);

var AV_COLORS=["#ef4444","#f97316","#eab308","#22c55e","#14b8a6","#3b82f6","#8b5cf6","#ec4899","#64748b","#f59e0b"];

var token=localStorage.getItem("pix_token");
var user=null,color=ALL[2],tool="paint",brush=1,autoMode=false,pencilMode=false;
var scale=0.2,ox=0,oy=0,palPage=0,earnCD=0,earnCDMax=15,placing=false,channel="en";
var ERASE_COLOR="#ff00ea";
var pendingPlace=[]; // ordered queue for brush — flush after 2s idle or at 100
var pendingTimer=null;
var PENDING_IDLE_MS=2000;
var PENDING_MAX=100; // flush immediately when queue reaches this
var _glowThrottleAt=0; // war-cloud throttle ~8/sec
var GLOW_MIN_MS=125;
var deviceMode=localStorage.getItem("pix_device")||""; // "phone"|"pc"
var buildCfg={pencil:localStorage.getItem("bm_pencil")==="1",b3:localStorage.getItem("bm_3")==="1",b5:localStorage.getItem("bm_5")==="1",p3:localStorage.getItem("bm_p3")==="1",p5:localStorage.getItem("bm_p5")==="1"};
function shouldDraft(){
  if(pencilMode&&brush===3&&buildCfg.p3)return true;
  if(pencilMode&&brush===5&&buildCfg.p5)return true;
  if(pencilMode&&brush===1&&buildCfg.pencil)return true;
  if(!pencilMode&&brush===3&&buildCfg.b3)return true;
  if(!pencilMode&&brush===5&&buildCfg.b5)return true;
  // legacy default: if nothing configured, old behavior off — require explicit checkboxes
  return false;
}

var templates=[],gridEnabled=false,targetEnabled=false,landMode=0,pixelFx=localStorage.getItem("pix_fx")!=="0";
var speedWarns=0,pixelsThisSec=0,speedWindow=Date.now();
var localPixelCache={}; // "x,y" -> color for same-color skip
window.draftPixels = {};
window.draftCount = 0;
window.building = false;
var draftPixels = window.draftPixels;
function getDraftCount(){return window.draftCount|0;}
function setDraftCount(n){window.draftCount=n|0;}
var building = false;


var wrap=document.getElementById("canvas-wrap");
var canvas=document.getElementById("pixel-canvas");
canvas.width=SIZE;canvas.height=SIZE;var ctx=canvas.getContext("2d",{alpha:true});
var bgMap=document.getElementById("bg-map");
var tplC=document.getElementById("template-canvas");
var tplCtx=tplC.getContext("2d");
var gridC=document.getElementById("grid-canvas");
var gridCtx=gridC.getContext("2d");
var zoneC=document.getElementById("zone-canvas");
var zoneCtx=zoneC.getContext("2d");
ctx.clearRect(0,0,SIZE,SIZE);

function apply(){
  var t="translate("+ox+"px,"+oy+"px) scale("+scale+")";
  canvas.style.transform=t;bgMap.style.transform=t;tplC.style.transform=t;gridC.style.transform=t;zoneC.style.transform=t;
  if(gridEnabled&&scale>=4){drawScreenGrid();}else{var go=document.getElementById("grid-overlay");if(go)go.style.display="none";}
  gridC.style.display="none";
  document.getElementById("target-cross").style.display=targetEnabled?"block":"none";
  drawGlows();
}
function drawScreenGrid(){
  var go=document.getElementById("grid-overlay");
  if(!go)return;
  var w=wrap.clientWidth,h=wrap.clientHeight;
  if(go.width!==w){go.width=w;go.height=h;}
  go.style.display="block";
  var g=go.getContext("2d");
  g.clearRect(0,0,w,h);
  g.strokeStyle="rgba(0,0,0,0.35)";
  g.lineWidth=1;
  g.beginPath();
  // vertical lines at each world-pixel boundary
  var xStart=Math.floor((-ox)/scale);
  var yStart=Math.floor((-oy)/scale);
  var xEnd=Math.ceil((w-ox)/scale);
  var yEnd=Math.ceil((h-oy)/scale);
  for(var wx=xStart;wx<=xEnd;wx++){
    var sx=ox+wx*scale;
    g.moveTo(Math.round(sx)+0.5,0);g.lineTo(Math.round(sx)+0.5,h);
  }
  for(var wy=yStart;wy<=yEnd;wy++){
    var sy=oy+wy*scale;
    g.moveTo(0,Math.round(sy)+0.5);g.lineTo(w,Math.round(sy)+0.5);
  }
  g.stroke();
}
function drawGrid(){drawScreenGrid();}
function centerView(){
  var w=wrap.clientWidth||window.innerWidth||360;
  var h=wrap.clientHeight||window.innerHeight||640;
  if(w<50)w=window.innerWidth||360;
  if(h<50)h=window.innerHeight||640;
  scale=Math.min(w/SIZE,h/SIZE)*0.95;
  // center map in view
  ox=(w-SIZE*scale)/2;
  oy=(h-SIZE*scale)/2;
  apply();
}
function centerOn(wx,wy,s){
  var w=wrap.clientWidth||window.innerWidth||360;
  var h=wrap.clientHeight||window.innerHeight||640;
  if(s)scale=s;
  ox=w/2-wx*scale-scale/2;
  oy=h/2-wy*scale-scale/2;
  apply();
}

function renderPal(){
  var el=document.getElementById("palette");el.innerHTML="";
  var pages=PAGES.map(function(p){return p.slice();});
  if(pages.length){
    customColors.forEach(function(c){if(pages[pages.length-1].indexOf(c)<0)pages[pages.length-1].push(c);});
    if(user&&user.is_mod){
      if(pages[pages.length-1].indexOf(ERASE_COLOR)<0)pages[pages.length-1].push(ERASE_COLOR);
    }
    pages[pages.length-1].push("__add__");
  }
  pages.forEach(function(page){
    var pg=document.createElement("div");pg.className="pal-page";
    page.forEach(function(c){
      if(c==="__add__"){
        var d=document.createElement("div");d.className="swatch";
        d.style.cssText="background:#111;border:2px solid gold;color:gold;display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:700";
        d.textContent="+";d.title="Add custom color";
        d.onclick=function(){addCustomColor();};
        pg.appendChild(d);return;
      }
      var d=document.createElement("div");d.className="swatch"+(c===color?" selected":"");d.style.background=c;
      if(c===WATER){d.style.outline="1px dashed #fff";d.title="Water";}
      if(c===ERASE_COLOR){d.style.background="repeating-conic-gradient(#ff00ea 0% 25%,#111 0% 50%) 50%/12px 12px";d.title="ERASE (mod)";d.style.border="2px solid #ef4444";}
      if(customColors.indexOf(c)>=0){d.style.border="2px solid gold";d.title="Hold to edit";}
      d.onclick=function(){color=c;renderPal();};
      d.oncontextmenu=function(e){e.preventDefault();if(customColors.indexOf(c)>=0)editCustomColor(c);};
      var holdT=null;
      d.addEventListener("touchstart",function(){if(customColors.indexOf(c)>=0)holdT=setTimeout(function(){editCustomColor(c);},550);},{passive:true});
      d.addEventListener("touchend",function(){clearTimeout(holdT);});
      pg.appendChild(d);
    });
    el.appendChild(pg);
  });
  el.style.transform="translateX(-"+(palPage*100)+"%)";
  document.getElementById("palette-page").textContent=(palPage+1)+"/"+pages.length;
}
async function addCustomColor(){
  if(!user||(!(user.medals&&user.medals.pixels_2m)&&!user.is_mod))return notify("Need 2M pixels medal");
  if(customColors.length>=10)return notify("Max 10");
  var hex=prompt("Hex #RRGGBB","#ff00ff");
  if(!hex||!/^#[0-9a-fA-F]{6}$/.test(hex))return notify("Invalid hex");
  customColors.push(hex.toLowerCase());await saveCustomColors();renderPal();
}
async function editCustomColor(c){
  var hex=prompt("New hex / empty=delete",c);
  if(hex===null)return;
  var i=customColors.indexOf(c);
  if(hex==="")customColors.splice(i,1);
  else if(/^#[0-9a-fA-F]{6}$/.test(hex))customColors[i]=hex.toLowerCase();
  await saveCustomColors();renderPal();
}
async function saveCustomColors(){if(!token)return;try{await api("/colors",{method:"POST",json:{colors:customColors}});}catch(e){notify(e.message);}}
async function loadCustomColors(){if(!token)return;try{customColors=await api("/colors")||[];renderPal();}catch(e){}}

document.getElementById("pal-prev").onclick=function(){palPage=(palPage-1+PAGES.length)%PAGES.length;renderPal();};
document.getElementById("pal-next").onclick=function(){palPage=(palPage+1)%PAGES.length;renderPal();};
// swipe on palette
(function(){
  var startX=0,swiping=false;
  var wrapEl=document.getElementById("palette-wrap");
  wrapEl.addEventListener("touchstart",function(e){startX=e.touches[0].clientX;swiping=true;},{passive:true});
  wrapEl.addEventListener("touchend",function(e){
    if(!swiping)return;swiping=false;
    var dx=e.changedTouches[0].clientX-startX;
    if(dx<-40){palPage=Math.min(PAGES.length-1,palPage+1);renderPal();}
    if(dx>40){palPage=Math.max(0,palPage-1);renderPal();}
  },{passive:true});
})();
renderPal();

async function api(path,opts){
  opts=opts||{};var headers=Object.assign({},opts.headers||{});
  if(token)headers.Authorization="Bearer "+token;
  if(opts.json){headers["Content-Type"]="application/json";opts.body=JSON.stringify(opts.json);}
  var res=await fetch(path,Object.assign({},opts,{headers:headers}));
  var data={};try{data=await res.json();}catch(e){}
  if(!res.ok){
    var msg=typeof data.detail==="string"?data.detail:(data.msg||res.statusText||"Error");
    if(msg==="NOT_AUTHORIZED"||res.status===401)showAuthBlock();
    throw new Error(msg);
  }
  return data;
}
function showAuthBlock(){var ab=document.getElementById("auth-block");if(ab){ab.classList.add("show");setTimeout(function(){ab.classList.remove("show");},2000);}}


async function loadMe(){
  try{
    var d=await api("/me");
    if(d.guest){user=null;document.getElementById("pix-info").textContent="0/0";document.getElementById("admin-btn").style.display="none";}
    else{user=d;document.getElementById("pix-info").textContent=d.pixels_left+"/"+d.limit;document.getElementById("admin-btn").style.display=d.is_mod?"grid":"none";}
    if(typeof d.online==="number")document.getElementById("mid-on").textContent=fmtN(d.online);
  }catch(e){}
}
function fmtN(n){n=Number(n)||0;if(n>=1e6)return(n/1e6).toFixed(1).replace(/\.0$/,"")+"m";if(n>=1e3)return(n/1e3).toFixed(1).replace(/\.0$/,"")+"k";return String(n);}
async function loadStats(){try{var s=await api("/stats");var a=document.getElementById("mid-px");var b=document.getElementById("mid-on");if(a)a.textContent=fmtN(s.pixels||0);if(b)b.textContent=fmtN(s.online||0);}catch(e){console.warn("stats",e);}}
window.__bootMap=function(){
  try{centerView();}catch(e){}
  loadStats();
  loadPixels();
};
setTimeout(function(){if(window.__bootMap)window.__bootMap();},0);


// Coin cooldown UI
function updateCoinUI(){
  var btn=document.getElementById("coin-btn");
  var fill=document.getElementById("coin-fill");
  if(earnCD>0){
    btn.classList.add("cd");btn.classList.remove("ready");
    fill.style.height=((1-earnCD/earnCDMax)*100)+"%";
  }else{
    btn.classList.remove("cd");btn.classList.add("ready");
    fill.style.height="100%";
  }
}
setInterval(function(){if(earnCD>0){earnCD=Math.max(0,earnCD-0.1);updateCoinUI();}},100);

// WS — Stage 1: heartbeat + auto-reconnect + dead connection
var ws = null;
var wsReconnectDelay = 2000;
var wsHeartbeatTimer = null;
var wsWatchdogTimer = null;
var wsLastPong = 0;
var wsConnecting = false;
var WS_HEARTBEAT_MS = 20000;   // ping every 20s
var WS_DEAD_MS = 60000;        // no pong for 60s → force close
var WS_RECONNECT_MAX = 30000;  // max backoff 30s

function clearWsTimers(){
  if(wsHeartbeatTimer){clearInterval(wsHeartbeatTimer);wsHeartbeatTimer=null;}
  if(wsWatchdogTimer){clearInterval(wsWatchdogTimer);wsWatchdogTimer=null;}
}

function wsIsOpen(){
  return ws && ws.readyState === WebSocket.OPEN;
}

function wsSendSafe(data){
  if(!wsIsOpen())return false;
  try{ws.send(typeof data==="string"?data:JSON.stringify(data));return true;}catch(e){return false;}
}

function startWsHeartbeat(){
  clearWsTimers();
  wsLastPong = Date.now();
  wsHeartbeatTimer = setInterval(function(){
    if(!wsIsOpen())return;
    try{
      window.__wsPingAt = Date.now();
      ws.send("ping");
    }catch(e){}
  }, WS_HEARTBEAT_MS);
  wsWatchdogTimer = setInterval(function(){
    if(!ws)return;
    if(Date.now() - wsLastPong > WS_DEAD_MS){
      try{ws.close();}catch(e){}
    }
  }, 5000);
}

function connectWS(){
  if(wsConnecting)return;
  if(ws && (ws.readyState===WebSocket.OPEN || ws.readyState===WebSocket.CONNECTING))return;
  wsConnecting = true;
  clearWsTimers();
  var p = location.protocol==="https:"?"wss":"ws";
  try{
    ws = new WebSocket(p+"://"+location.host+"/ws");
  }catch(e){
    wsConnecting = false;
    document.getElementById("status").textContent="offline";
    scheduleWsReconnect();
    return;
  }
  ws.onopen = function(){
    wsConnecting = false;
    wsReconnectDelay = 2000;
    wsLastPong = Date.now();
    document.getElementById("status").textContent="Online";
    document.getElementById("status").style.color="var(--green)";
    startWsHeartbeat();
    if(token) wsSendSafe({type:"identify",token:token});
  };
  ws.onerror = function(){
    document.getElementById("status").textContent="...";
  };
  ws.onclose = function(){
    wsConnecting = false;
    clearWsTimers();
    document.getElementById("status").textContent="...";
    scheduleWsReconnect();
  };
  ws.onmessage = function(ev){
    // plain pong from server heartbeat
    if(ev.data === "pong"){
      wsLastPong = Date.now();
      if(window.__wsPingAt){
        var rtt = Math.max(0, wsLastPong - window.__wsPingAt);
        window.__wsPingMs = rtt;
        var pel = document.getElementById("ping");
        if(pel){
          pel.textContent = rtt + " ms";
          if(rtt < 80) pel.style.color = "var(--green)";
          else if(rtt < 200) pel.style.color = "var(--gold)";
          else pel.style.color = "var(--danger)";
        }
      }
      return;
    }
    try{
      var m = JSON.parse(ev.data);
      if(m.type==="px"&&m.p&&m.p.length){
        var arr=m.p;
        for(var i=0;i<arr.length;i++){
          var x=arr[i][0], y=arr[i][1], c=arr[i][2];
          ctx.fillStyle=c;ctx.fillRect(x,y,1,1);localPixelCache[x+","+y]=c;
        }
        var lp=arr[arr.length-1];
        if(!placingLocal) throttledWar(lp[0],lp[1],null);
        lastRemote={x:lp[0],y:lp[1],t:Date.now(),user:null};
      }
      if(m.type==="pixel"){
        if(!user||m.username!==user.username){
          lastRemote={x:m.x,y:m.y,t:m.t?new Date(m.t).getTime():Date.now(),user:m.username};
        }
        ctx.fillStyle=m.color;ctx.fillRect(m.x,m.y,1,1);localPixelCache[m.x+","+m.y]=m.color;
        if(m.war || !placingLocal){ throttledWar(m.x,m.y,m.username); }
      }
      if(m.type==="pixels"&&m.pixels){
        m.pixels.forEach(function(p){
          ctx.fillStyle=p.color;ctx.fillRect(p.x,p.y,1,1);localPixelCache[p.x+","+p.y]=p.color;
        });
        if(m.pixels.length){
          var lp2=m.pixels[m.pixels.length-1];
          if(m.war||!placingLocal) throttledWar(lp2.x,lp2.y,m.username);
        }
      }
      if(m.type==="erase"){
        ctx.clearRect(m.x,m.y,1,1);
        delete localPixelCache[m.x+","+m.y];
        throttledWar(m.x,m.y,m.username);
      }
      if(m.type==="clear"){ctx.clearRect(m.x1,m.y1,m.x2-m.x1+1,m.y2-m.y1+1);}
      if(m.type==="clear_all"){ctx.clearRect(0,0,SIZE,SIZE);localPixelCache={};}
      if(m.type==="recolor"){/* reload */}
      if(m.type==="wipe"){ notify("Account wiped: @"+(m.username||"?")); }
      if(m.type==="chat"){
        appendChat(m);
        markChatNew();
      }
      if(m.type==="event"){
        applyEventOverlay(m);
        if(m.ended||m.mode===null){notify("EVENT ENDED");}
        else if(m.mode){notify("EVENT: "+m.mode+(m.minutes?(" "+m.minutes+"m"):""));}
        try{loadMe();}catch(e){}
      }
      if(m.type==="window_sms"){showWindowSms(m);}
      if(m.type==="zone")drawZone(m);
      if(m.type==="clan_boost"){
        var ban=document.getElementById("boost-banner");
        if(ban){
          ban.textContent=(m.display_name||m.from)+" — activated BOOST — +50 pixels";
          ban.style.display="block";
          setTimeout(function(){ban.style.display="none";},4000);
        }
        try{loadMe();}catch(e){}
      }
      // Stage 2 later: sync pixels_left from server
      if(m.type==="pixels_left" && user && typeof m.left==="number"){
        user.pixels_left = m.left;
        var hud=document.getElementById("pix-info");
        if(hud)hud.textContent=user.pixels_left+"/"+(user.limit||0);
      }
    }catch(e){}
  };
}

function scheduleWsReconnect(){
  if(wsConnecting)return;
  var delay = wsReconnectDelay;
  wsReconnectDelay = Math.min(WS_RECONNECT_MAX, Math.floor(wsReconnectDelay * 1.6));
  setTimeout(connectWS, delay);
}

function drawZone(z){
  zoneCtx.fillStyle="rgba(0,220,255,0.05)";
  zoneCtx.fillRect(z.x1,z.y1,z.x2-z.x1+1,z.y2-z.y1+1);
  zoneCtx.strokeStyle="rgba(0,220,255,0.15)";
  zoneCtx.lineWidth=2;
  zoneCtx.strokeRect(z.x1,z.y1,z.x2-z.x1+1,z.y2-z.y1+1);
}
async function loadZones(){
  try{var zs=await api("/zones");zoneCtx.clearRect(0,0,SIZE,SIZE);zs.forEach(drawZone);}catch(e){}
}

function zoomAt(cx,cy,factor){var ns=Math.min(40,Math.max(0.05,scale*factor));ox=cx-(cx-ox)*(ns/scale);oy=cy-(cy-oy)*(ns/scale);scale=ns;apply();}
wrap.addEventListener("wheel",function(e){e.preventDefault();var r=wrap.getBoundingClientRect();zoomAt(e.clientX-r.left,e.clientY-r.top,e.deltaY>0?0.9:1.12);},{passive:false});

var mode=null,startX=0,startY=0,lastX=0,lastY=0,moved=false,pinch=null,drawQueue=[],drawTimer=null;
wrap.addEventListener("pointerdown",function(e){
  if(e.pointerType==="mouse"&&e.button===2){mode="pan";lastX=e.clientX;lastY=e.clientY;moved=false;return;}
  if(e.pointerType==="mouse"&&e.button!==0)return;
  mode="maybe";startX=lastX=e.clientX;startY=lastY=e.clientY;moved=false;
  try{wrap.setPointerCapture(e.pointerId);}catch(err){}
});
wrap.addEventListener("pointermove",function(e){
  if(pinch)return;
  if(!mode)return;
  var prevX=lastX,prevY=lastY;
  var dx=e.clientX-lastX,dy=e.clientY-lastY;lastX=e.clientX;lastY=e.clientY;
  if(mode==="maybe"&&(Math.abs(e.clientX-startX)>8||Math.abs(e.clientY-startY)>8)){
    if(tool==="paint"&&pencilMode){mode="draw";moved=true;lastDrawPt=null;}
    else{mode="pan";moved=true;}
  }
  if(mode==="pan"){ox+=dx;oy+=dy;apply();moved=true;}
  if(mode==="draw"){
    var steps=Math.max(1,Math.ceil(Math.hypot(dx,dy)/Math.max(2,scale*0.4)));
    for(var si=1;si<=steps;si++){
      var tt=si/steps;
      queueDraw(prevX+dx*tt, prevY+dy*tt);
    }
  }
});
wrap.addEventListener("pointerup",function(e){
  if(mode==="maybe"&&!moved){
    if(tool==="paint"||tool==="pipette")handleTap(e.clientX,e.clientY);
  }
  if(mode==="draw")flushDraw();
  lastDrawPt=null;mode=null;moved=false;
});
wrap.addEventListener("pointercancel",function(){mode=null;});
wrap.addEventListener("contextmenu",function(e){e.preventDefault();});
wrap.addEventListener("touchstart",function(e){if(e.touches.length===2){var dx=e.touches[0].clientX-e.touches[1].clientX,dy=e.touches[0].clientY-e.touches[1].clientY;pinch={dist:Math.hypot(dx,dy)};mode=null;}},{passive:true});
wrap.addEventListener("touchmove",function(e){if(pinch&&e.touches.length===2){var dx=e.touches[0].clientX-e.touches[1].clientX,dy=e.touches[0].clientY-e.touches[1].clientY;var dist=Math.hypot(dx,dy);var r=wrap.getBoundingClientRect();var cx=(e.touches[0].clientX+e.touches[1].clientX)/2-r.left;var cy=(e.touches[0].clientY+e.touches[1].clientY)/2-r.top;zoomAt(cx,cy,dist/(pinch.dist||dist));pinch.dist=dist;}},{passive:true});
wrap.addEventListener("touchend",function(e){if(e.touches.length<2)pinch=null;},{passive:true});

function screenToWorld(sx,sy){var r=wrap.getBoundingClientRect();return {x:Math.floor((sx-r.left-ox)/scale),y:Math.floor((sy-r.top-oy)/scale)};}
function updateCoords(sx,sy){var p=screenToWorld(sx,sy);if(p.x>=0&&p.y>=0&&p.x<SIZE&&p.y<SIZE)document.getElementById("coords").textContent=String(p.x).padStart(4,"0")+" x "+String(p.y).padStart(4,"0");}
window.addEventListener("pointermove",function(e){updateCoords(e.clientX,e.clientY);});

function nearestPalette(hex){
  function parse(h){h=h.replace("#","");if(h.length===3)h=h[0]+h[0]+h[1]+h[1]+h[2]+h[2];return[parseInt(h.slice(0,2),16),parseInt(h.slice(2,4),16),parseInt(h.slice(4,6),16)];}
  var t=parse(hex);var best=ALL[0],bd=1e9;
  ALL.forEach(function(c){var p=parse(c);var d=(p[0]-t[0])*(p[0]-t[0])+(p[1]-t[1])*(p[1]-t[1])+(p[2]-t[2])*(p[2]-t[2]);if(d<bd){bd=d;best=c;}});
  return best;
}
var _tplSampleC=document.createElement("canvas");_tplSampleC.width=1;_tplSampleC.height=1;var _tplSampleG=_tplSampleC.getContext("2d",{willReadFrequently:true});
function sampleTemplate(x,y){
  for(var i=0;i<templates.length;i++){
    var t=templates[i];
    if(x<t.x||y<t.y||x>=t.x+t.w||y>=t.y+t.h)continue;
    try{
      var lx=x-t.x,ly=y-t.y;
      var sx=lx*(t.img.width/t.w),sy=ly*(t.img.height/t.h);
      _tplSampleG.clearRect(0,0,1,1);
      _tplSampleG.drawImage(t.img,sx,sy,Math.max(0.01,t.img.width/t.w),Math.max(0.01,t.img.height/t.h),0,0,1,1);
      var d=_tplSampleG.getImageData(0,0,1,1).data;
      if(d[3]<20)continue;
      return nearestPalette("#"+[d[0],d[1],d[2]].map(function(v){return v.toString(16).padStart(2,"0");}).join(""));
    }catch(e){}
  }
  return null;
}
var landMask=null,_bgData=null;
function buildLandMask(){
  try{
    var c=document.createElement("canvas");c.width=SIZE;c.height=SIZE;
    var g=c.getContext("2d",{willReadFrequently:true});
    g.drawImage(bgMap,0,0,SIZE,SIZE);
    var img=g.getImageData(0,0,SIZE,SIZE);_bgData=img.data;
    landMask=new Uint8Array(SIZE*SIZE);
    for(var i=0,p=0;i<_bgData.length;i+=4,p++){
      var r=_bgData[i],gg=_bgData[i+1],b=_bgData[i+2];
      landMask[p]=(b>r+15&&b>gg+10)?0:1;
    }
  }catch(e){landMask=null;_bgData=null;}
}
function isLand(x,y){
  if(x<0||y<0||x>=SIZE||y>=SIZE)return false;
  if(landMask)return landMask[y*SIZE+x]===1;
  var c=sampleBg(x,y);
  try{var r=parseInt(c.slice(1,3),16),g=parseInt(c.slice(3,5),16),b=parseInt(c.slice(5,7),16);return !(b>r+15&&b>g+10);}catch(e){return true;}
}
function sampleBg(x,y){
  try{
    if(_bgData&&x>=0&&y>=0&&x<SIZE&&y<SIZE){
      var i=(y*SIZE+x)*4;
      return "#"+[_bgData[i],_bgData[i+1],_bgData[i+2]].map(function(v){return v.toString(16).padStart(2,"0");}).join("");
    }
    var c=document.createElement("canvas");c.width=1;c.height=1;var g=c.getContext("2d");
    g.drawImage(bgMap,x,y,1,1,0,0,1,1);var d=g.getImageData(0,0,1,1).data;
    return "#"+[d[0],d[1],d[2]].map(function(v){return v.toString(16).padStart(2,"0");}).join("");
  }catch(e){return "#ffffff";}
}
function bgLabel(hex){
  try{var h=(hex||"").toLowerCase();var r=parseInt(h.slice(1,3),16),g=parseInt(h.slice(3,5),16),b=parseInt(h.slice(5,7),16);
    if(b>r+20&&b>g)return "sea / water";if(r>200&&g>200&&b>200)return "land";return hex;
  }catch(e){return hex;}
}


function isLightColor(col){
  try{
    var h=(col||"").replace("#","");
    if(h.length===3)h=h[0]+h[0]+h[1]+h[1]+h[2]+h[2];
    var r=parseInt(h.slice(0,2),16),g=parseInt(h.slice(2,4),16),b=parseInt(h.slice(4,6),16);
    // ONLY near-gray / white (not pink, not pastel colors)
    var spread=Math.max(r,g,b)-Math.min(r,g,b);
    if(spread>18)return false; // has color tint
    var lum=(r+g+b)/3;
    return lum>=70; // white to medium-dark gray
  }catch(e){return false;}
}
function paintDraftPixel(x,y,col){
  ctx.globalAlpha=0.8;
  ctx.fillStyle=col;
  ctx.fillRect(x,y,1,1);
  ctx.globalAlpha=1;
  // outline only for pure gray/white (cheap check)
  if(isLightColor(col)){
    ctx.fillStyle="rgba(0,0,0,0.55)";
    // thin border via 4 edge pixels - faster than strokeRect at scale
    // skip heavy stroke for speed
    ctx.strokeStyle="rgba(0,0,0,0.7)";
    ctx.lineWidth=0.08;
    ctx.strokeRect(x+0.04,y+0.04,0.92,0.92);
  }else if(gridEnabled){
    ctx.strokeStyle="rgba(255,40,40,0.8)";
    ctx.lineWidth=0.08;
    ctx.strokeRect(x+0.04,y+0.04,0.92,0.92);
  }
}
var _draftUiT=null;
function scheduleDraftUI(){
  if(_draftUiT)return;
  _draftUiT=setTimeout(function(){_draftUiT=null;updateDraftUI();},80);
}
function redrawDrafts(){
  Object.keys(window.draftPixels).forEach(function(k){
    var p=window.draftPixels[k];
    // restore under
    if(localPixelCache[k]){ctx.fillStyle=localPixelCache[k];ctx.fillRect(p.x,p.y,1,1);}
    else{ctx.clearRect(p.x,p.y,1,1);}
    paintDraftPixel(p.x,p.y,p.color);
  });
}

function phantomPixel(x,y,col){
  ctx.fillStyle=col;ctx.fillRect(x,y,1,1);
  localPixelCache[x+","+y]=col;
}
function rollbackPixels(list){
  if(!list||!list.length)return;
  list.forEach(function(p){
    var key=p.x+","+p.y;
    if(p.prev){
      ctx.fillStyle=p.prev;ctx.fillRect(p.x,p.y,1,1);
      localPixelCache[key]=p.prev;
    }else{
      ctx.clearRect(p.x,p.y,1,1);
      delete localPixelCache[key];
    }
  });
}
function getPrevColor(x,y){
  var k=x+","+y;
  return localPixelCache.hasOwnProperty(k)?localPixelCache[k]:null;
}

var glowMarks=[]; // {x,y,born}
var lastRemote=null;
var placingLocal=false; // true while we place so we ignore our own WS echo briefly
function remoteGlow(wx,wy,uname){
  glowMarks.push({x:wx,y:wy,born:Date.now()});
  lastRemote={x:wx,y:wy,t:Date.now(),user:uname||null};
  var now=Date.now();
  glowMarks=glowMarks.filter(function(g){return now-g.born<900;});
  if(glowMarks.length>24)glowMarks=glowMarks.slice(-16);
  drawGlows();
}
function drawGlows(){
  var gc=document.getElementById("glow-canvas");
  if(!gc)return;
  var w=wrap.clientWidth,h=wrap.clientHeight;
  if(gc.width!==w){gc.width=w;gc.height=h;}
  var g=gc.getContext("2d");
  g.clearRect(0,0,w,h);
  var now=Date.now();
  glowMarks=glowMarks.filter(function(m){return now-m.born<900;});
  glowMarks.forEach(function(m){
    var age=(now-m.born)/900;
    var sx=ox+m.x*scale+scale/2;
    var sy=oy+m.y*scale+scale/2;
    var radius=Math.max(18, scale*5)*(0.7+age*0.9);
    var alpha=0.55*(1-age);
    var grd=g.createRadialGradient(sx,sy,0,sx,sy,radius);
    grd.addColorStop(0,"rgba(255,70,90,"+alpha+")");
    grd.addColorStop(0.45,"rgba(255,50,70,"+(alpha*0.35)+")");
    grd.addColorStop(1,"rgba(255,40,60,0)");
    g.fillStyle=grd;
    g.beginPath();g.arc(sx,sy,radius,0,Math.PI*2);g.fill();
  });
}
setInterval(function(){if(glowMarks.length)drawGlows();},80);

function spawnCloud(wx,wy){
  if(document.querySelectorAll(".war-cloud").length>12)return;
  var r=wrap.getBoundingClientRect();
  var sx=ox+wx*scale+scale/2+r.left;
  var sy=oy+wy*scale+scale/2+r.top;
  var el=document.createElement("div");
  el.className="war-cloud";
  el.style.cssText="position:fixed;left:"+sx+"px;top:"+sy+"px;width:"+Math.max(12,scale*3)+"px;height:"+Math.max(12,scale*3)+"px;margin-left:-"+Math.max(6,scale*1.5)+"px;margin-top:-"+Math.max(6,scale*1.5)+"px;border-radius:50%;background:radial-gradient(circle,rgba(255,60,60,0.55) 0%,rgba(255,80,80,0.15) 50%,transparent 70%);pointer-events:none;z-index:60;animation:cloudFx .6s ease-out forwards";
  document.body.appendChild(el);
  setTimeout(function(){el.remove();},650);
}
function throttledWar(x,y,uname){
  var now=Date.now();
  if(now-_glowThrottleAt<GLOW_MIN_MS){
    lastRemote={x:x,y:y,t:now,user:uname||null};
    return;
  }
  _glowThrottleAt=now;
  remoteGlow(x,y,uname);
  spawnCloud(x,y);
}


var lastDrawPt=null;
function placeAt(p){
  var half=Math.floor(brush/2);
  for(var dy=-half;dy<=half;dy++)for(var dx=-half;dx<=half;dx++){
    var px=p.x+dx,py=p.y+dy;if(px<0||py<0||px>=SIZE||py>=SIZE)continue;
    if(landMode===1&&!isLand(px,py))continue;
    if(landMode===2&&isLand(px,py))continue;
    var col=color;
    if(autoMode){var sc=sampleTemplate(px,py);if(!sc)continue;col=sc;}
    var key=px+","+py;
    if(col!==ERASE_COLOR && localPixelCache[key]===col)continue;
    var useDraft=shouldDraft();
    if(useDraft){
      if(window.draftPixels[key])continue;
      window.draftPixels[key]={x:px,y:py,color:col};
      window.draftCount=(window.draftCount|0)+1;
      paintDraftPixel(px,py,col);
      scheduleDraftUI();
      continue;
    }
    var prev=getPrevColor(px,py);
    if(col===ERASE_COLOR){
      ctx.clearRect(px,py,1,1);delete localPixelCache[key];
      drawQueue.push({x:px,y:py,color:col,prev:prev,erase:true});
    }else{
      phantomPixel(px,py,col);
      drawQueue.push({x:px,y:py,color:col,prev:prev});
    }
  }
}
function updateDraftUI(){
  try{
    var bar=document.getElementById("build-bar");
    var pc=document.getElementById("pal-cost");
    var pg=document.getElementById("palette-page");
    var have=user?(user.pixels_left||0):0;
    var dc=window.draftCount|0;
    var buildMode=shouldDraft();
    if(buildMode){
      if(bar){bar.style.display="flex";bar.style.flexDirection="column";bar.style.alignItems="center";bar.style.zIndex="160";}
      var bp=document.getElementById("build-placed");if(bp)bp.textContent=dc;
      var bh=document.getElementById("build-have");if(bh)bh.textContent=have;
      autoBuildRate();
      if(dc>0){
        if(pc){pc.style.display="inline-block";pc.textContent="-"+dc+"/"+have;}
        if(pg)pg.style.display="none";
      }else{
        if(pc)pc.style.display="none";
        if(pg)pg.style.display="inline";
      }
    }else{
      if(bar)bar.style.display="none";
      if(pc)pc.style.display="none";
      if(pg)pg.style.display="inline";
    }
  }catch(e){}
}

function clearDraft(){
  // redraw affected from cache/server - simple: reload area by clearing phantoms that were draft
  Object.keys(window.draftPixels).forEach(function(k){
    var p=window.draftPixels[k];
    if(localPixelCache[k]){ctx.fillStyle=localPixelCache[k];ctx.fillRect(p.x,p.y,1,1);}
    else{ctx.clearRect(p.x,p.y,1,1);}
  });
  window.draftPixels={};window.draftCount=0;updateDraftUI();
}
async function confirmDraft(){
  if(window.building||!window.draftCount||!token)return;
  var left=user?(user.pixels_left||0):0;
  if(left<=0&&!(user&&user.god_mode)){flashHudDenied();notify("Немає пікселів");return;}
  var rateEl=document.getElementById("build-rate");
  var rate=parseInt(rateEl&&rateEl.value,10);
  if(!rate||rate<1)rate=10;
  rate=Math.min(500,rate);
  var keys=Object.keys(window.draftPixels);
  var chunk=keys.slice(0,Math.min(rate,left,keys.length));
  if(!chunk.length)return;
  window.building=true;
  placingLocal=true;
  try{
    var pixels=chunk.map(function(k){return window.draftPixels[k];});
    // one batch request — fast
    if(pixels.length===1)await api("/place",{method:"POST",json:pixels[0]});
    else await api("/place_batch",{method:"POST",json:{pixels:pixels}});
    pixels.forEach(function(p){
      phantomPixel(p.x,p.y,p.color);
      delete window.draftPixels[p.x+","+p.y];
    });
    window.draftCount=Object.keys(window.draftPixels).length;
    if(user&&!user.god_mode)user.pixels_left=Math.max(0,(user.pixels_left||0)-pixels.length);
    var hud=document.getElementById("hud-pixels");
    if(hud)hud.innerHTML="Pixels: <b>"+(user.pixels_left||0)+"/"+(user.limit||0)+"</b>";
    showSpend(pixels.length);
    updateDraftUI();
    loadMe();loadStats();
    notify("+"+pixels.length);
  }catch(e){
    notify(e.message||"Stop");
  }finally{
    window.building=false;
    setTimeout(function(){placingLocal=false;},200);
    updateDraftUI();
  }
}
function autoBuildRate(){
  var n=window.draftCount|0;
  var el=document.getElementById("build-rate");
  if(!el||el.dataset.user)return;
  // 10 per ~100, 20 per ~200...
  var v=Math.max(10, Math.min(100, Math.round(n/10)*10 || 10));
  if(v>n)v=Math.max(1,n);
  el.value=v;
}
function queueDraw(sx,sy){
  if(!user){showAuthBlock();return;}
  var p=screenToWorld(sx,sy);
  if(p.x<0||p.y<0||p.x>=SIZE||p.y>=SIZE)return;
  // fill gaps between points (Bresenham)
  if(lastDrawPt){
    var x0=lastDrawPt.x,y0=lastDrawPt.y,x1=p.x,y1=p.y;
    var dx=Math.abs(x1-x0),dy=Math.abs(y1-y0);
    var sx0=x0<x1?1:-1,sy0=y0<y1?1:-1;
    var err=dx-dy,x=x0,y=y0;
    while(true){
      placeAt({x:x,y:y});
      if(x===x1&&y===y1)break;
      var e2=2*err;
      if(e2>-dy){err-=dy;x+=sx0;}
      if(e2<dx){err+=dx;y+=sy0;}
    }
  }else placeAt(p);
  lastDrawPt=p;
  if(!drawTimer)drawTimer=setTimeout(flushDraw,25);
}
function pruneDraftToBalance(){
  // (1)(2) if phantoms > available pixels — drop excess from the end
  var left=user?(user.pixels_left||0):0;
  if(user&&user.god_mode)return;
  var keys=Object.keys(window.draftPixels||{});
  if(keys.length>left){
    var drop=keys.slice(left);
    drop.forEach(function(k){
      var p=window.draftPixels[k];
      if(p){if(localPixelCache[k]){ctx.fillStyle=localPixelCache[k];ctx.fillRect(p.x,p.y,1,1);}else{ctx.clearRect(p.x,p.y,1,1);}}
      delete window.draftPixels[k];
    });
    window.draftCount=Object.keys(window.draftPixels).length;
    updateDraftUI();
    flashHudDenied();
  }
}
async function flushDraw(){
  drawTimer=null;
  if(!drawQueue.length)return;
  var left=user?(user.pixels_left||0):0;
  if(!user||(left<=0&&!(user&&user.god_mode))){
    var dead=drawQueue.splice(0,drawQueue.length);
    rollbackPixels(dead);
    flashHudDenied();
    return;
  }
  // (4) send groups of max 100; fewer HTTP requests
  var maxN=user&&user.god_mode?100:Math.min(100,left);
  if(maxN<=0){
    var dead2=drawQueue.splice(0,drawQueue.length);
    rollbackPixels(dead2);
    flashHudDenied();
    return;
  }
  var batch=drawQueue.splice(0,maxN);
  if(!(user&&user.god_mode) && batch.length>left){
    rollbackPixels(batch);
    flashHudDenied();
    drawQueue=[];
    return;
  }
  var erases=batch.filter(function(p){return p.erase||p.color===ERASE_COLOR;});
  var paints=batch.filter(function(p){return !(p.erase||p.color===ERASE_COLOR);});
  try{
    placingLocal=true;
    for(var ei=0;ei<erases.length;ei++){
      try{await api("/place",{method:"POST",json:{x:erases[ei].x,y:erases[ei].y,color:ERASE_COLOR}});}catch(e){}
    }
    var payload=paints.map(function(p){return {x:p.x,y:p.y,color:p.color};});
    if(payload.length===1){await api("/place",{method:"POST",json:payload[0]});showSpend(1);}
    else if(payload.length>1){await api("/place_batch",{method:"POST",json:{pixels:payload}});showSpend(payload.length);}
    if(user&&!user.god_mode&&payload.length)user.pixels_left=Math.max(0,(user.pixels_left||0)-payload.length);
    // after partial place, drop remaining phantoms over balance
    left=user?(user.pixels_left||0):0;
    if(drawQueue.length>left&&!(user&&user.god_mode)){
      var rest=drawQueue.splice(left,drawQueue.length);
      rollbackPixels(rest);
      flashHudDenied();
    }
    loadMe();
  }catch(err){
    // whole group fails → rollback group
    rollbackPixels(batch);
    flashHudDenied();
  }finally{
    setTimeout(function(){placingLocal=false;},200);
  }
  left=user?(user.pixels_left||0):0;
  if(drawQueue.length&&left<=0&&!(user&&user.god_mode)){
    var rest2=drawQueue.splice(0,drawQueue.length);
    rollbackPixels(rest2);
    flashHudDenied();
    return;
  }
  if(drawQueue.length)drawTimer=setTimeout(flushDraw,40);
}

function schedulePendingFlush(){
  if(pendingTimer)clearTimeout(pendingTimer);
  if(pendingPlace.length>=PENDING_MAX){
    flushPendingPlace();
    return;
  }
  pendingTimer=setTimeout(flushPendingPlace, PENDING_IDLE_MS);
}
async function flushPendingPlace(){
  pendingTimer=null;
  if(!pendingPlace.length||!token){pendingPlace=[];return;}
  if(placing){schedulePendingFlush();return;}
  placing=true;
  placingLocal=true;
  var queue=pendingPlace.splice(0,PENDING_MAX);
  try{
    for(var s=0;s<queue.length;s+=100){
      var chunk=queue.slice(s,s+100).map(function(p){return {x:p.x,y:p.y,color:p.color};});
      try{
        if(chunk.length===1)await api("/place",{method:"POST",json:chunk[0]});
        else await api("/place_batch",{method:"POST",json:{pixels:chunk}});
        if(chunk.length)throttledWar(chunk[chunk.length-1].x,chunk[chunk.length-1].y,user&&user.username);
        if(user&&!user.god_mode)user.pixels_left=Math.max(0,(user.pixels_left||0)-chunk.length);
        showSpend(chunk.length);
      }catch(e){
        var rest=queue.slice(s);
        rollbackPixels(rest);
        notify(e.message||"Place failed");
        break;
      }
    }
    loadMe();loadStats();
  }finally{
    placing=false;
    setTimeout(function(){placingLocal=false;},400);
    if(pendingPlace.length)schedulePendingFlush();
  }
}
async function handleTap(sx,sy){
  if(tool==="pipette"){
    var p=screenToWorld(sx,sy);
    var key=p.x+","+p.y;
    var c=localPixelCache[key];
    if(c){color=c;renderPal();notify("Color "+c);tool="paint";document.querySelectorAll(".tool").forEach(function(t){t.classList.remove("active");});var tp=document.getElementById("tool-paint");if(tp)tp.classList.add("active");}
    else notify("Empty pixel");
    return;
  }
  if(!user){showAuthBlock();return;}
  var p=screenToWorld(sx,sy);
  if(p.x<0||p.y<0||p.x>=SIZE||p.y>=SIZE)return;
  var half=Math.floor(brush/2);
  var useDraft=shouldDraft();
  var batch=[];
  var useMask=brush===5 && document.getElementById("use-custom-brush") && document.getElementById("use-custom-brush").checked;
  for(var dy=-half;dy<=half;dy++)for(var dx=-half;dx<=half;dx++){
    if(useMask){
      var mi=(dy+half)*5+(dx+half);
      if(!window.customBrushMask||!window.customBrushMask[mi])continue;
    }
    var px=p.x+dx,py=p.y+dy;if(px<0||py<0||px>=SIZE||py>=SIZE)continue;
    var col=color;
    if(landMode===1&&!isLand(px,py))continue;
    if(landMode===2&&isLand(px,py))continue;
    if(autoMode){var sc=sampleTemplate(px,py);if(!sc)continue;col=sc;}
    var key=px+","+py;
    if(col!==ERASE_COLOR && localPixelCache[key]===col)continue;
    if(useDraft){
      if(window.draftPixels[key])continue;
      window.draftPixels[key]={x:px,y:py,color:col};window.draftCount=(window.draftCount|0)+1;
      paintDraftPixel(px,py,col);
      scheduleDraftUI();
      continue;
    }
    var prev=getPrevColor(px,py);
    if(col===ERASE_COLOR){
      // erase immediately for mods
      batch.push({x:px,y:py,color:col,prev:prev,erase:true});
      ctx.clearRect(px,py,1,1);delete localPixelCache[key];
    }else{
      phantomPixel(px,py,col);
      batch.push({x:px,y:py,color:col,prev:prev});
    }
  }
  if(useDraft){updateDraftUI();var _bb2=document.getElementById("build-bar");if(_bb2){_bb2.style.display="flex";_bb2.style.flexDirection="column";}return;}
  if(!batch.length)return;
  // erase path: send immediately
  if(batch[0]&&batch[0].erase){
    if(placing)return;placing=true;
    try{
      placingLocal=true;
      for(var i=0;i<batch.length;i++){
        try{await api("/place",{method:"POST",json:{x:batch[i].x,y:batch[i].y,color:ERASE_COLOR}});}catch(e){notify(e.message);break;}
      }
    }finally{placing=false;setTimeout(function(){placingLocal=false;},200);}
    return;
  }
  // brush: queue up to 100, flush after 2s idle or immediately at 100
  var left=user?(user.pixels_left||0):0;
  if(left<=0&&!(user&&user.god_mode)){
    rollbackPixels(batch);
    flashHudDenied();notify("Немає пікселів");
    return;
  }
  if(!user.god_mode && (pendingPlace.length+batch.length)>left){
    var can=Math.max(0,left-pendingPlace.length);
    if(can<=0){rollbackPixels(batch);flashHudDenied();return;}
    rollbackPixels(batch.slice(can));
    batch=batch.slice(0,can);
  }
  batch.forEach(function(p){
    if(pendingPlace.length>=PENDING_MAX*2){
      pendingPlace.shift();
    }
    var exists=pendingPlace.some(function(q){return q.x===p.x&&q.y===p.y;});
    if(!exists)pendingPlace.push(p);
  });
  schedulePendingFlush();
}

