    '</div><div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:8px">'+
    medalHTML("2M","STOCK +10",!!m.pixels_2m)+
    medalHTML("YouTube","STOCK +15",!!m.youtube)+
    medalHTML("Day #1","EARN +2 · STOCK +30",ranks.daily===1)+
    medalHTML("All #1","EARN +3 · EARN AFK ×4 · STOCK +65",ranks.alltime===1)+
    '</div>'+(user.is_twink?"<p style='color:#fbbf24;font-size:12px;margin-top:6px'>TWINK — limits/earn/AFK ÷3</p>":"")+
    (user.is_mod?'<div class="row" style="margin-top:10px"><button type="button" onclick="openSwipe()">SWIPE</button></div>':'');
  var r=user.ranks||{};
ri.innerHTML="Day rank: <b>"+(r.daily||"—")+"</b> · All-time: <b>"+(r.alltime||"—")+"</b><br>Earn bonus: +"+(user.earn_bonus||0)+" · AFK: "+(user.afk_rate||0.5)+"/s";
  document.getElementById("av-color").value=user.avatar_color||0;
  document.getElementById("btn-logout").style.display="inline-block";
  openOv("ov-profile");
};
