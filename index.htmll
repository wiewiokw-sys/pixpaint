// Load pixels — viewport chunk first (fast start), then full map in background
async function loadPixels(){
  var statusEl=document.getElementById("status");
  try{
    if(statusEl)statusEl.textContent="Loading map...";
    // 1) load viewport area first
    var r=wrap.getBoundingClientRect();
    var vx=Math.max(0,Math.floor((-ox)/scale)-64);
    var vy=Math.max(0,Math.floor((-oy)/scale)-64);
    var vw=Math.min(SIZE, vx+Math.ceil(r.width/scale)+128);
    var vh=Math.min(SIZE, vy+Math.ceil(r.height/scale)+128);
    try{
      var near=await api("/canvas/chunk?x1="+vx+"&y1="+vy+"&x2="+vw+"&y2="+vh);
      (near||[]).forEach(function(p){
        ctx.fillStyle=p.color;ctx.fillRect(p.x,p.y,1,1);
        localPixelCache[p.x+","+p.y]=p.color;
      });
      if(statusEl)statusEl.textContent="Map near OK…";
    }catch(e0){}
    // 2) full map in background (sliced)
    var data=await api("/canvas/all");
    var xs=data.xs||[], ys=data.ys||[], cs=data.cs||[];
    var n=xs.length|0;
    var mid=document.getElementById("mid-px");
    if(mid)mid.textContent=fmtN(data.count||n);
    if(!n){
      if(statusEl)statusEl.textContent="Online";
      return;
    }
    var i=0, BATCH=25000;
    function slice(){
      var end=Math.min(i+BATCH, n);
      var t0=performance.now();
      for(;i<end;i++){
        var x=xs[i], y=ys[i], col=cs[i];
        if(x<0||y<0||x>=SIZE||y>=SIZE)continue;
        localPixelCache[x+","+y]=col;
        ctx.fillStyle=col;
        ctx.fillRect(x,y,1,1);
      }
      if(i<n){
        if(statusEl)statusEl.textContent="Map "+Math.floor(i/n*100)+"%";
        // yield so chat/UI stay responsive; continue ASAP
        if(performance.now()-t0>12) requestAnimationFrame(slice);
        else setTimeout(slice,0);
      }else{
        if(statusEl){statusEl.textContent="Online";statusEl.style.color="var(--green)";}
      }
    }
    slice();
  }catch(e){
    console.warn("all failed, chunk fallback", e);
    try{
      var step=512, jobs=[], maxJobs=64, count=0;
      var cx=Math.max(0,Math.floor((-ox)/scale));
      var cy=Math.max(0,Math.floor((-oy)/scale));
      for(var rad=0;rad<SIZE&&count<maxJobs;rad+=step){
        for(var y=Math.max(0,cy-rad);y<Math.min(SIZE,cy+rad+step)&&count<maxJobs;y+=step){
          for(var x=Math.max(0,cx-rad);x<Math.min(SIZE,cx+rad+step)&&count<maxJobs;x+=step){
            (function(x0,y0){
              jobs.push(api("/canvas/chunk?x1="+x0+"&y1="+y0+"&x2="+(x0+step)+"&y2="+(y0+step)).then(function(chunk){
                (chunk||[]).forEach(function(p){
                  ctx.fillStyle=p.color;ctx.fillRect(p.x,p.y,1,1);
                  localPixelCache[p.x+","+p.y]=p.color;
                });
              }).catch(function(){}));
            })(x,y);
            count++;
          }
        }
      }
      await Promise.all(jobs);
      if(statusEl)statusEl.textContent="Online";
    }catch(e2){console.warn(e2);}
  }
}


var KEYS_TEXT = [
"W/A/S/D — move camera",
"Z / X — zoom in / out",
"Q — pixel / template mode",
"E — land / water / both",
"R — radar",
"C — chat · 1-4 channels",
"K — close windows",
"M — earn · T — pencil · H — cursor"
].join(String.fromCharCode(10));

function showKeysHelp(fromSettings){
  var pre=document.getElementById("keys-help");
  if(pre)pre.textContent=KEYS_TEXT;
  openOv("ov-keys");
}
function flashHudDenied(){
  var t=document.getElementById("hud");
  if(!t)return;
  t.classList.add("flash-red");
  setTimeout(function(){t.classList.remove("flash-red");t.style.background="";},500);
}
function applyEventOverlay(m){
  var el=document.getElementById("event-overlay");
  if(!el)return;
  el.className="";
  el.style.removeProperty("--ev-op");
  if(!m||!m.mode||m.ended){el.style.display="none";return;}
  if(m.mode==="select"){showSelectEvent(m);return;}
  if(m.overlay){
    el.className=m.mode;
    el.style.display="block";
    var op = (typeof m.opacity==="number")?m.opacity:0.8;
    el.style.setProperty("--ev-op", String(op));
  }else{el.style.display="none";}
}
function showSelectEvent(m){
  var panel=document.getElementById("select-panel");
  if(!panel)return;
  panel.classList.add("show");
  var btns=panel.querySelectorAll("#select-grid button");
  btns.forEach(function(b){b.classList.remove("go");b.disabled=true;});
  document.getElementById("select-title").textContent="ВЫБЕРИТЕ";
  var canAt=Date.now()+3000;
  var endAt=Date.now()+10000;
  var timerEl=document.getElementById("select-timer");
  var iv=setInterval(function(){
    var left=Math.max(0,Math.ceil((endAt-Date.now())/1000));
    if(timerEl)timerEl.textContent=left+"s";
    if(Date.now()>=canAt){btns.forEach(function(b){b.classList.add("go");b.disabled=false;});}
    if(Date.now()>=endAt){clearInterval(iv);panel.classList.remove("show");notify("No choice — no bonus");}
  },200);
  btns.forEach(function(b){
    b.onclick=async function(){
      if(Date.now()<canAt)return;
      clearInterval(iv);
      panel.classList.remove("show");
      try{
        await api("/event/select",{method:"POST",json:{choice:b.dataset.c}});
        notify("Choice "+b.dataset.c+" — bonus in 1 min");
      }catch(e){notify(e.message);}
    };
  });
}
function showWindowSms(m){
  if(!m||!m.text)return;
  var box=document.getElementById("window-sms");
  if(!box)return;
  document.getElementById("wsms-from").textContent="@"+(m.from||"mod");
  document.getElementById("wsms-text").textContent=m.text;
  box.style.display="flex";
  localStorage.setItem("wsms_seen", m.created||Date.now());
}
