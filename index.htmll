document.getElementById("btn-settings").onclick=function(){
  document.getElementById("menu").classList.remove("show");loadBuildCfgUI();openOv("ov-settings");
  var g=document.getElementById("tog-grid");g.checked=gridEnabled;g.onchange=function(){gridEnabled=g.checked;apply();redrawDrafts();};
  var tg=document.getElementById("tog-target");tg.checked=targetEnabled;tg.onchange=function(){targetEnabled=tg.checked;apply();};
  var lg=document.getElementById("lang");if(lg){lg.value=curLang;lg.onchange=function(){curLang=lg.value;localStorage.setItem("pix_lang",curLang);applyI18n();notify(curLang);};}
  var pe=document.getElementById("tog-fx");if(pe){pe.checked=pixelFx;pe.onchange=function(){pixelFx=pe.checked;localStorage.setItem("pix_fx",pixelFx?"1":"0");};}
};
